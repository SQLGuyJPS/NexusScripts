{"name":"equip","enabled":true,"description":"","type":"group","id":1,"items":[{"type":"function","name":"onLoad","enabled":true,"id":2,"code":"eqm = {};\n\n/*\nEquipment Manager\n=================\nEQM: Parse your weapons and armor into EQM. This may take a bit.\nEQSUMMARY: View a summary of details about your equipment.\nMAKESET <alias> <IMPACT|EM|THERMAL|CELLULAR|MENTAL|DRAINING|ELECTRIC>: Will make a set of armor with the specified alias from your inventory, maximizing the specified resistance.\nMAKESET EQUIPPED <alias>: Creates a new armor set out of the currently equipped armor.\nARMORSETS: View your defined armor sets.\nARMORSET DELETE <alias>: delete the specified armor set.\nARMORSET EQUIP <alias>: equips the specified armor set. Use it multiple times until everything is equipped.\nSCRAPALL ARMOR: Will scrap all armor pieces which are not part of a defined set or worn/equipped.\nSCRAPALL WEAPONS <power>: Will scrap all weapons below the specified power.\n*/\n\neqm.parseEq = false;\neqm.armor = {};\neqm.weapons = {};\nrun_function('utils',false,'Equip');\neqm.sets = get_variable('eqm.sets') || {};\nconst slots = ['head','torso','arms','hands','waist','legs','feet'];\n\neqm.scrapList = [];\neqm.scrapAllWeapons = function(power) {\n    eqm.scrapList = [];\n    for (var id in eqm.weapons) {\n        if (eqm.weapons[id].power < power) {\n            eqm.scrapList.push(id);\n        }\n    }\n    eqm.scrapping = true;\n    eqm.scrapNext();\n}\neqm.usedInSet = {};\neqm.scrapAllArmor = function() {\n    eqm.usedInSet = {};\n    for (var alias in eqm.sets) {\n        for (var slot in eqm.sets[alias]) {\n            eqm.usedInSet[eqm.sets[alias][slot].id] = 1;\n        }\n    }\n    for (var id in eqm.armor) {\n        if (id in eqm.usedInSet) continue;\n        eqm.scrapList.push(id);\n    }\n    eqm.scrapping = true;\n    eqm.scrapNext();\n}\n\neqm.scrapNext = function() {\n    if (eqm.scrapList.length == 0) {\n    \teqm.scrapping = false;\n        eqm.report('Finished scrapping');\n        return;\n    }\n    var id = eqm.scrapList[0];\n    eqm.scrapList.shift();\n    send_command('JUNK SCRAP '+id);\n}\n\neqm.muSlot = function(mu) {\n    if (!(mu in mus)) return;\n    mus.forEach(function(el, i){\n        send_command('armor upgrade '+slots[i]+' with '+mus[mu]);\n    })\n}\nvar sleep = function(ms) {\n  return new Promise(resolve => setTimeout(resolve, ms));\n}\neqm.parsingId = '';\neqm.toParse = [];\neqm.armorGetInfoInit = function() {\n    var list = Object.keys(eqm.armor);\n    eqm.toParse = list.slice();\n    eqm.armorGetNext();\n    \n    /*for (var id in eqm.armor) {\n        eqm.parsingId = id;\n        send_command('armor probe '+id);\n        await sleep(750);\n    }*/\n    //crunchIt();\n}\neqm.armorGetNext = function() {\n    if (eqm.toParse.length == 0) {\n        crunchIt();\n        return;\n    }\n    eqm.parsingId = eqm.toParse[0];\n    eqm.toParse.shift();\n    send_command('armor probe '+eqm.parsingId);\n    \n}\n\neqm.summary = {\n    totalWeaponCount: 0,\n    totalArmorCount: 0,\n    maxResists : {'impact':0,'em':0,'thermal':0,'cellular':0,'mental':0,'draining':0,'electric':0},\n    highestPower : {},\n}\n\neqm.displaySets = function() {\n    eqm.report('====Armor sets===');\n    for (var s in eqm.sets) {\n        eqm.report('   Armor set '+vs.coemph(s)+':');\n        var arr = [];\n        for (var slot in eqm.sets[s]) {\n            arr.push(eqm.mxp(eqm.sets[s][slot].id, 'ARMOR PROBE '+eqm.sets[s][slot].id));\n        }\n        eqm.report('         '+arr.join(', '));\n    }\n}\n\n//called with alias EQMSUMMARY\neqm.displaySummary = function() {\n    eqm.report('=====Equipment summary=====');\n    eqm.report('Total weapon count: '+eqm.coemph(eqm.summary.totalWeaponCount));\n    eqm.report('Total armor count:  '+eqm.coemph(eqm.summary.totalArmorCount));\n    eqm.report('Possible max resistances:');\n    for (var m in eqm.summary.maxResists) {\n        eqm.report('           '+m+': '+eqm.coemph(eqm.summary.maxResists[m]));\n    }\n    for (var w in eqm.summary.highestPower) {\n    \teqm.report('Your highest power '+w+' is id '+eqm.mxp(eqm.summary.highestPower[w].id,'PROBE '+eqm.summary.highestPower[w].id)+\n                   ' with a power of '+eqm.coemph(eqm.summary.highestPower[w].power));\n    }\n}\n\n\nfunction crunchIt() {\n    eqm.summary.totalArmorCount = Object.keys(eqm.armor).length;\n    eqm.summary.totalWeaponCount = Object.keys(eqm.weapons).length;\n    for (var t in eqm.summary.maxResists) {\n        eqm.summary.maxResists[t] = eqm.max(t).average;\n    }\n    loadHighestPower();\n    setTimeout(function(){\n        eqm.report('Completed collection');\n        eqm.displaySummary();\n    },500);\n}\n\nfunction loadHighestPower() {\n    for (var w in eqm.weapons) {\n        var weapon = eqm.weapons[w];\n        var type = weapon.type;\n        var id = w\n        var power = weapon.power;\n        if (!(type in eqm.summary.highestPower)) {\n            eqm.summary.highestPower[type] = {'power':power,'id':id};\n            continue;\n        }\n        if (power > eqm.summary.highestPower[type].power) {\n            eqm.summary.highestPower[type].power = power;\n            eqm.summary.highestPower[type].id = id;\n        }\n        \n    }\n}\n\neqm.max = function(stat) {\n    var result = {};\n    slots.forEach(function(el){\n        var max = Number.NEGATIVE_INFINITY;\n        for (var id in eqm.armor) {\n            if (eqm.armor[id].slot !== el) continue;\n            if (eqm.armor[id][stat] > max) {\n                max = eqm.armor[id][stat];\n                result[el]={'id':id,'resist':max};\n            }\n        }\n    });\n    var total = 0;\n    for (var r in result) {\n        total+=result[r].resist;\n    }\n    result.average = total/7\n    result.average = Math.round(result.average * 100) / 100\n    return result;\n}\n\neqm.makeSetEquipped = function(alias) {\n    if (alias in eqm.sets) {\n        eqm.error('An armor set with that alias already exists');\n        return;\n    }\n    eqm.dashCount=0;\n    eqm.armorEquipsetAlias = alias;\n    eqm.equippedArmor = [];\n    eqm.parseArmorEquipset = true;\n    send_command('armor list');\n}\n\neqm.armorEquipsetGo = function() {\n    var result = {};\n    slots.forEach(function(el) {\n        eqm.equippedArmor.forEach(function(id){\n            if (eqm.armor[id].slot == el) result[el]={'id':id};\n        });\n    });\n    eqm.sets[eqm.armorEquipsetAlias] = result;\n    eqm.report('Created a new set '+eqm.coemph(eqm.armorEquipsetAlias)+' from equipped armor','green')\n    set_variable('eqm.sets',eqm.sets);\n}\n\neqm.makeSet = function(alias, resist) {\n    if (alias in eqm.sets) {\n        eqm.error('An armor set with that alias already exists');\n        return;\n    }\n    var set = eqm.max(resist);\n    var average = set.average;\n    delete set.average;\n    for (var s in set) {\n        delete set[s].resist;\n    }\n    eqm.sets[alias] = set;\n    eqm.report('Created a new set '+eqm.coemph(alias)+' to resist '+eqm.coemph(resist)+' with average resist '+eqm.coemph(average),'green')\n    set_variable('eqm.sets',eqm.sets);\n}"},{"type":"function","name":"utils","enabled":true,"id":15,"code":"eqm = typeof eqm != 'undefined' ? eqm : {}\n\neqm.settings = {};\neqm.settings.colors = {\n    tag : '&Lang;   eqm   &Rang;',\n    tagc : 'rgb(51, 133, 255)',\n    msgc : 'rgb(204, 242, 255)',\n    emphc: 'rgb(51, 204, 255)',\n    errc: 'rgb(255, 103, 76)',\n};\n\neqm.mxp = function(str, href) {\n    return \"<a class='mxp_send' href='\"+href+\"'style=\\'color:#d7ff87\\'>\"+str+\"</a>\";\n}\neqm.coemph = function(str) {return '<span style=\"color:'+eqm.settings.colors.emphc+';\"/>'+str+'</span>';}\neqm.coerr = function(str) {return '<span style=\"color:'+eqm.settings.colors.errc+';\"/>'+str+'</span>';}\n\n\neqm.report = function(msg) { eqm.owWrite('#output_main', '<div style=\"color: ' + eqm.settings.colors.tagc + ';\">' + eqm.settings.colors.tag + ': <span style=\"color: ' + eqm.settings.colors.msgc + ';\">' + msg + '</span></div>') };\neqm.error = function(msg) {eqm.report(eqm.coerr(msg));}\n\n//this is a redefinition of the owWrite function found natively in the client to make sure the output gets logged\neqm.owWrite = function(selector, text) {\n    if (text.trim() == \"\") return;\n\n    // doing these updates asynchronously to minimize reflows when under heavy load\n    window.requestAnimationFrame(function() {\n        var hooks = $.cssHooks;\n        $.cssHooks = {};\n\n        var output = client.document.querySelectorAll(selector + ' .output')[0];\n        var newel = document.createElement('div');\n        newel.innerHTML = text;\n        newel.className = 'line';\n        newel.id = 'msg' + num_msgs;\n        output.appendChild(newel);\n        if(client.logging){append_to_log(newel.innerHTML);}\n\n        var scrollback = client.document.querySelectorAll(selector + ' .output_scrollback')[0];\n        newel = document.createElement('div');\n        newel.className = 'line';\n        newel.innerHTML = text;\n        newel.id = 'sb_msg' + num_msgs;\n        scrollback.appendChild(newel);\n\n        trim_ow(selector);\n\n        num_msgs++;\n        scrollback_num_msgs++;\n\n        if (selector === '#output_main') {\n           if (no_prompts || gag_prompts) {\n               var el = client.document.querySelectorAll('#output_main .prompt');\n               for (var i = 0; i < el.length; i++) el[i].style.display = 'none';\n               // last prompt shown?\n               if ((!no_prompts) && el.length > 0)\n                   el[el.length - 1].style.display = 'block';\n           }\n           if (show_timestamps) {\n               var el = client.document.querySelectorAll('#output_main .output #msg'+(num_msgs-1)+' .timestamp');\n               for (var i = 0; i < el.length; i++) el[i].classList.remove('no_out');\n           }\n           if (show_scroll_timestamps) {\n               var el = client.document.querySelectorAll('#output_main .output_scrollback #sb_msg'+(num_msgs-1)+' .timestamp');\n               for (var i = 0; i < el.length; i++) el[i].classList.remove('no_out');\n           }\n        }\n\n        output.scrollTop = output.scrollHeight;\n\n        $.cssHooks = hooks;\n    });\n\n};","items":[]},{"type":"group","name":"Aliases","enabled":true,"id":12,"items":[{"type":"alias","name":"","enabled":true,"id":4,"matching":"regexp","whole_words":true,"case_sensitive":false,"prefix_suffix":true,"actions":[{"action":"script","script":"eqm.armor = {};\neqm.weapons = {};\neqm.parseEq = true;\nsend_command('armor list inv');\nsend_command('armor list');\nsend_command('weapon list inv');\nsend_command('weapon list');"}],"text":"^eqm$"},{"type":"alias","name":"","enabled":true,"id":13,"matching":"regexp","whole_words":true,"case_sensitive":false,"prefix_suffix":true,"actions":[{"action":"script","script":"eqm.displaySummary();"}],"text":"^eqsummary$"},{"type":"alias","name":"","enabled":true,"id":16,"matching":"regexp","whole_words":true,"case_sensitive":false,"prefix_suffix":true,"actions":[{"action":"script","script":"eqm.makeSet(args[1],args[2]);"}],"text":"^MAKESET (\\S+) (IMPACT|EM|THERMAL|CELLULAR|MENTAL|DRAINING|ELECTRIC)$"},{"type":"alias","name":"","enabled":true,"id":17,"matching":"regexp","whole_words":true,"case_sensitive":false,"prefix_suffix":true,"actions":[{"action":"script","script":"eqm.makeSetEquipped(args[1]);"}],"text":"^MAKESET EQUIPPED (\\S+)$"},{"type":"alias","name":"","enabled":true,"id":19,"matching":"regexp","whole_words":true,"case_sensitive":false,"prefix_suffix":true,"actions":[{"action":"script","script":"eqm.displaySets();"}],"text":"^ARMORSETS$"},{"type":"alias","name":"","enabled":true,"id":20,"matching":"regexp","whole_words":true,"case_sensitive":false,"prefix_suffix":true,"actions":[{"action":"script","script":"var alias = args[1];\nif (!(alias in eqm.sets)) {\n    eqm.error('No such armor set');\n    return;\n}\ndelete eqm.sets[alias];\neqm.report('Deleted armor set '+eqm.coemph(alias));"}],"text":"^ARMORSET DELETE (\\S+)$"},{"type":"alias","name":"","enabled":true,"id":21,"matching":"regexp","whole_words":true,"case_sensitive":false,"prefix_suffix":true,"actions":[{"action":"script","script":"var alias = args[1];\nif (!(alias in eqm.sets)) {\n    eqm.error('No such armor set');\n    return;\n}\nfor (var s in eqm.sets[alias]) {\n    send_command('ARMOR UPGRADE '+s+ ' with '+eqm.sets[alias][s].id);\n}"}],"text":"^ARMORSET EQUIP (\\S+)$"},{"type":"alias","name":"","enabled":true,"id":23,"matching":"regexp","whole_words":true,"case_sensitive":false,"prefix_suffix":true,"actions":[{"action":"script","script":"eqm.scrapAllWeapons(parseInt(args[1]));"}],"text":"^SCRAPALL WEAPONS (\\d+)$"},{"type":"alias","name":"","enabled":true,"id":24,"matching":"regexp","whole_words":true,"case_sensitive":false,"prefix_suffix":true,"actions":[{"action":"script","script":"eqm.scrapAllArmor();"}],"text":"^SCRAPALL ARMOR$"}],"actions":[]},{"type":"group","name":"Triggers","enabled":true,"id":11,"items":[{"type":"trigger","name":"","enabled":true,"id":3,"matching":"regexp","whole_words":true,"case_sensitive":true,"text":"(head|arms|hands|waist|legs|feet|torso)\\s+(\\d+).+","actions":[{"action":"script","script":"if (eqm.parseEq) eqm.armor[args[2]] = {'slot':args[1]};\nif (eqm.parseArmorEquipset) eqm.equippedArmor.push(args[2]);"}]},{"type":"trigger","name":"","enabled":true,"id":6,"matching":"regexp","whole_words":true,"case_sensitive":true,"text":"\\s+(Impact|EM|Thermal|Cellular|Mental|Draining|Electric):\\s+(\\d+)\\.(\\d+)\\%","actions":[{"action":"script","script":"var type = args[1].toLowerCase();\nvar percent = parseFloat(args[2]+'.'+args[3]);\neqm.armor[eqm.parsingId][type] = percent;\nif (type == 'electric') eqm.armorGetNext();"}]},{"type":"trigger","name":"","enabled":true,"id":9,"matching":"regexp","whole_words":true,"case_sensitive":true,"text":"^(toolkit|gauntlet|goggles|knuckleduster?|piece|shield|wristblade|minigun|netlauncher|missiles|railgun|kithblade)\\s+(\\d+)\\s+.+?(toolkit|gauntlet|goggles|knuckleduster|piece|shield|wristblade|minigun|netlauncher|missiles|railgun|kithblade)\\s+X?\\s*(\\d+).+","actions":[{"action":"script","script":"if (!eqm.parseEq) return;\nvar type = args[1];\nvar id = args[2];\nvar power = parseInt(args[4]);\neqm.weapons[id] = {'type':type,'power':power};"}]},{"type":"trigger","name":"","enabled":true,"id":10,"matching":"regexp","whole_words":true,"case_sensitive":true,"text":".+Used weapons.+","actions":[{"action":"script","script":"if (!eqm.parseEq) return;\nsetTimeout(function(){\n    eqm.parseEq = false;\n    eqm.armorGetInfoInit();\n}, 1000);"}]},{"type":"trigger","name":"","enabled":true,"id":18,"matching":"regexp","whole_words":true,"case_sensitive":true,"text":"^\\-\\-\\-\\-\\-\\-\\-\\-\\-\\-\\-\\-\\-\\-\\-\\-\\-\\-\\-\\-\\-\\-\\-\\-\\-\\-\\-\\-\\-\\-\\-\\-\\-\\-\\-\\-\\-\\-\\-\\-\\-\\-\\-\\-\\-\\-\\-\\-\\-\\-\\-\\-\\-\\-\\-\\-\\-\\-\\-\\-\\-\\-\\-\\-\\-\\-\\-\\-\\-\\-\\-\\-\\-\\-\\-\\-\\-\\-\\-\\-\\-\\-\\-\\-$","actions":[{"action":"script","script":"if (eqm.parseArmorEquipset) {\n    eqm.dashCount++;\n    if (eqm.dashCount == 2) {\n        eqm.parseArmorEquipset = false;\n        eqm.armorEquipsetGo();\n    }\n}"}]},{"type":"trigger","name":"","enabled":true,"id":22,"matching":"regexp","whole_words":true,"case_sensitive":true,"text":"You are about to scrap .+","actions":[{"action":"script","script":"if (eqm.scrapping) {\n    send_command('agree');\n    eqm.scrapNext();\n}"}]},{"type":"trigger","name":"","enabled":true,"id":25,"matching":"regexp","whole_words":true,"case_sensitive":true,"text":"You cannot scrap a wielded item.","actions":[{"action":"script","script":"if (eqm.scrapping) {\n    eqm.scrapNext();\n}"}]},{"type":"trigger","name":"","enabled":true,"id":26,"matching":"regexp","whole_words":true,"case_sensitive":true,"text":"There is no such item in your inventory.","actions":[{"action":"script","script":"if (eqm.scrapping) {\n    eqm.scrapNext();\n}"}]}],"actions":[]}]}