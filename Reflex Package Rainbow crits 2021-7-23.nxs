{"name":"rainbow crits","enabled":true,"description":"Triggers for highlighting crits of different types, and crits from other people","type":"group","id":1,"items":[{"type":"trigger","name":"first person crushing","enabled":true,"id":2,"matching":"regexp","whole_words":true,"case_sensitive":true,"text":"^You have scored a CRUSHING CRITICAL hit.$","actions":[{"action":"gag"},{"action":"script","script":"//Enter the script here\nfunction getRandomInt(max) {\n  return Math.floor(Math.random() * max);\n}\n\n\nlet largeSpectrum = [\n    \"#FFFF00\",\n    \"#FFE800\",\n    \"#FFD100\",\n    \"#FFB900\",\n    \"#FF8B00\",\n    \"#FF7100\",\n    \"#FF5D00\",\n    \"#FF4600\",\n    \"#FF0000\",\n    \"#D1002E\",\n    \"#B90046\",\n    \"#A2005D\",\n    \"#8B0074\",\n    \"#74008B\",\n    \"#5D00A2\",\n    \"#2E00D1\",\n    \"#0000FF\",\n    \"#0055AA\",\n    \"#006F6F\",\n    \"#00805A\",\n    \"#009100\",\n    \"#55A200\",\n    \"#9AC300\",\n    \"#D5D400\",\n    \"#FFE500\"\n];\n\nlet triggerText = args[0];\nlet rainbowOutput = \"\";\n\n// Randomize this one?\nlet colorIndex = getRandomInt(largeSpectrum.length);\n\nfor (let char of triggerText) {\n    rainbowOutput = rainbowOutput + ('<span style=\"color:'+largeSpectrum[colorIndex]+'\">'+char+'</span>');\n    colorIndex += 1;\n    if(colorIndex >= largeSpectrum.length) colorIndex = 0;\n}\n\nprint(rainbowOutput);\n"}]},{"type":"trigger","name":"first person crit","enabled":true,"id":3,"matching":"regexp","whole_words":true,"case_sensitive":true,"text":"^You have scored a CRITICAL hit.$","actions":[{"action":"script","script":"function getRandomInt(max) {\n  return Math.floor(Math.random() * max);\n}\n\nlet normalCritSpectrum = [\n    \"#FFFF00\",\n    \"#FFE800\",\n    \"#FFD100\",\n    \"#FFB900\",\n    \"#FF8B00\",\n    \"#FF7100\",\n    \"#FF5D00\",\n    \"#FF4600\",\n    \"#FF0000\",\n    \"#FF4600\",\n    \"#FF5D00\",\n    \"#FF7100\",\n    \"#FF8B00\",\n    \"#FFB900\",\n    \"#FFD100\",\n    \"#FFE800\"\n];\n\n\nlet triggerText = args[0];\nlet rainbowOutput = \"\";\n\n// Randomize this one?\nlet colorIndex = getRandomInt(normalCritSpectrum.length);\n\nfor (let char of triggerText) {\n    rainbowOutput = rainbowOutput + ('<span style=\"color:'+normalCritSpectrum[colorIndex]+'\">'+char+'</span>');\n    colorIndex += 1;\n    if(colorIndex >= normalCritSpectrum.length) colorIndex = 0;\n}\n\nprint(rainbowOutput);\n"},{"action":"gag"}]},{"type":"trigger","name":"third person crit (any type)","enabled":true,"id":5,"matching":"regexp","whole_words":true,"case_sensitive":true,"text":"^(\\w+) has scored a (CRITICAL|CRUSHING CRITICAL) hit.$","actions":[{"action":"script","script":"function getRandomInt(max) {\n  return Math.floor(Math.random() * max);\n}\n\nlet allySpectrum = [\n    \"#0000FF\",\n    \"#0055AA\",\n    \"#006F6F\",\n    \"#00805A\",\n    \"#009100\",\n    \"#55A200\",\n    \"#9AC300\",\n    \"#D5D400\",\n    \"#FFE500\",\n    \"#D5D400\",\n    \"#9AC300\",\n    \"#55A200\",\n    \"#009100\",\n    \"#00805A\",\n    \"#006F6F\",\n    \"#0055AA\"\n];\n\n\nlet triggerText = args[0];\nlet rainbowOutput = \"\";\n\n// Randomize this one?\nlet colorIndex = getRandomInt(allySpectrum.length);\n\nfor (let char of triggerText) {\n    rainbowOutput = rainbowOutput + ('<span style=\"color:'+allySpectrum[colorIndex]+'\">'+char+'</span>');\n    colorIndex += 1;\n    if(colorIndex >= allySpectrum.length) colorIndex = 0;\n}\n\nprint(rainbowOutput);\n"},{"action":"gag"}]},{"type":"alias","name":"Color array copypastas","enabled":false,"id":4,"matching":"begins","whole_words":true,"case_sensitive":true,"prefix_suffix":true,"actions":[{"action":"script","script":"// A small and ugly rainbow, ngl\nlet smallSpectrum = [\n    \"#FF0000\",\n    \"#FF7F00\",\n    \"#FFFF00\",\n    \"#7FFF00\",\n    \"#00FF00\",\n    \"#00FF7F\",\n    \"#00FFFF\",\n    \"#007FFF\",\n    \"#0000FF\",\n    \"#7F00FF\",\n    \"#FF00FF\",\n    \"#FF07FF\"\n];\n\n// A bigger, smoother, prettier rainbow\nlet largeSpectrum = [\n    \"#FFFF00\",\n    \"#FFE800\",\n    \"#FFD100\",\n    \"#FFB900\",\n    \"#FF8B00\",\n    \"#FF7100\",\n    \"#FF5D00\",\n    \"#FF4600\",\n    \"#FF0000\",\n    \"#D1002E\",\n    \"#B90046\",\n    \"#A2005D\",\n    \"#8B0074\",\n    \"#74008B\",\n    \"#5D00A2\",\n    \"#2E00D1\",\n    \"#0000FF\",\n    \"#0055AA\",\n    \"#006F6F\",\n    \"#00805A\",\n    \"#009100\",\n    \"#55A200\",\n    \"#9AC300\",\n    \"#D5D400\",\n    \"#FFE500\"\n];\n\n// Yellow to red and back\nlet yellowRedSpectrum = [\n    \"#FFFF00\",\n    \"#FFE800\",\n    \"#FFD100\",\n    \"#FFB900\",\n    \"#FF8B00\",\n    \"#FF7100\",\n    \"#FF5D00\",\n    \"#FF4600\",\n    \"#FF0000\",\n    \"#FF4600\",\n    \"#FF5D00\",\n    \"#FF7100\",\n    \"#FF8B00\",\n    \"#FFB900\",\n    \"#FFD100\",\n    \"#FFE800\"\n];\n\n// Red to blue and back\nlet redBlueSpectrum = [\n    \"#FF0000\",\n    \"#D1002E\",\n    \"#B90046\",\n    \"#A2005D\",\n    \"#8B0074\",\n    \"#74008B\",\n    \"#5D00A2\",\n    \"#2E00D1\",\n    \"#0000FF\",\n    \"#2E00D1\",\n    \"#5D00A2\",\n    \"#74008B\",\n    \"#8B0074\",\n    \"#A2005D\",\n    \"#B90046\",\n    \"#D1002E\"\n    \n];\n\n// Blue to yellow and back\nlet blueYellowSpectrum = [\n    \"#0000FF\",\n    \"#0055AA\",\n    \"#006F6F\",\n    \"#00805A\",\n    \"#009100\",\n    \"#55A200\",\n    \"#9AC300\",\n    \"#D5D400\",\n    \"#FFE500\",\n    \"#D5D400\",\n    \"#9AC300\",\n    \"#55A200\",\n    \"#009100\",\n    \"#00805A\",\n    \"#006F6F\",\n    \"#0055AA\"\n];"}],"text":"arraydump12345"}]}