mber(get_variable(\"my_pt\"))\n\nif (parts > 11) {send_command(\"BOT CONSTRUCT CARRYBOT\")} else {display_notice(\"Not enough Parts. Please GADGET CONSTRUCT WORKSTATION and OPERATE WORKSTATION to build up to 12 parts before you can BOT CONSTRUCT CARRYBOT\")}\n  "}],"text":"^You have not built any carrybot.$","matching":"regexp","whole_words":true,"case_sensitive":true}]},{"type":"group","name":"Scoundrel Triggers","enabled":true,"items":[{"type":"alias","name":"Scoundrel Def Up","enabled":true,"actions":[{"type":"script","enabled":true,"script":"let bullets = Number(get_variable(\"my_bl\"))\nlet gsrank = Number(get_variable(\"GunslingingRank\"))\nlet gurank = Number(get_variable(\"GuileRank\"))\nlet imrank = Number(get_variable(\"ImprovisationRank\"))\nlet atk = \"\"\nlet tar = get_variable(\"tar\")\nlet ripper = Number(get_variable(\"ripper_avail\"))\n\nif (get_variable(\"defup\") == \"1\") {\n  if (get_variable(\"wwprio\") != \"health\") {send_command(\"wwh\")} else\n  if (imrank > 5 && ripper < 500) {send_command(\"ied construct ripper\")} else\n  if (gsrank > 17 && get_variable(\"bullet_ammo\") != \"combusting\") {send_command(\"gun switch combusting\")} else\n  {set_variable(\"defup\",\"0\")\n   display_notice(\"***DEFS UP***\",\"Yellow\")}\n}"}],"text":"scoundefup","matching":"exact","whole_words":true,"case_sensitive":true,"prefix_suffix":true},{"type":"trigger","name":"Empty Bandolier","enabled":true,"actions":[{"type":"script","enabled":true,"script":"set_variable(\"ripper_avail\",\"0\")"}],"text":"^Your bandolier is empty.$","matching":"regexp","whole_words":true,"case_sensitive":true},{"type":"trigger","name":"Ripper count","enabled":true,"actions":[{"type":"script","enabled":true,"script":"let rippers = Number(args[1])\nset_variable(\"ripper_avail\",rippers)"}],"text":"^.+\\[ (\\d|\\d+)\\] Ripper$","matching":"regexp","whole_words":true,"case_sensitive":true},{"type":"trigger","name":"Ripper Made","enabled":true,"actions":[{"type":"script","enabled":true,"script":"let rippersadded = Number(args[1])\nlet rippers = Number(get_variable(\"ripper_avail\"))\n\nlet newrippers = rippers + rippersadded\n\nset_variable(\"ripper_avail\",newrippers)"}],"text":"^Using whatever supplies you have on hand, you skillfully construct (\\d+) handfuls of explosive putty.+$","matching":"regexp","whole_words":true,"case_sensitive":true},{"type":"trigger","name":"Bullet Ammo","enabled":true,"actions":[{"type":"script","enabled":true,"script":"let ammo = args[1]\nset_variable(\"bullet_ammo\",ammo)"}],"text":"^You spin the chamber of the ammo case on your belt until (\\w+) bullets come up, ready to use.$","matching":"regexp","whole_words":true,"case_sensitive":true},{"type":"trigger","name":"Bullet Ammo Alr","enabled":true,"actions":[{"type":"script","enabled":true,"script":"let ammo = args[1]\nset_variable(\"bullet_ammo\",ammo)\nif(get_variable(\"defup\") == \"1\") {send_command(\"defup\")}"}],"text":"^You are already using a payload of (\\w+) bullets.$","matching":"regexp","whole_words":true,"case_sensitive":true},{"type":"trigger","name":"Ambush Used","enabled":true,"actions":[{"type":"script","enabled":true,"script":"set_variable(\"ambush_avail\",\"0\")"}],"text":"^You.+Gun Ambush.+$","matching":"regexp","whole_words":true,"case_sensitive":true},{"type":"trigger","name":"Ambush Ready","enabled":true,"actions":[{"type":"script","enabled":true,"script":"set_variable(\"ambush_avail\",\"1\")"}],"text":"^You are again ready to ambush.$","matching":"regexp","whole_words":true,"case_sensitive":true},{"type":"trigger","name":"Ambush Used Verbose","enabled":true,"actions":[{"type":"script","enabled":true,"script":"set_variable(\"ambush_avail\",\"0\")"}],"text":"^Without warning, you snatch.+from your belt and fire it from the hip at.+moving too rapidly to be spotted until the bullet is already leaving the barrel.$","matching":"regexp","whole_words":true,"case_sensitive":true},{"type":"trigger","name":"Ambush/Rapidfire Used","enabled":true,"actio