len<client.prioitemsarray.length)&&(mobarrayprio.indexOf(n) < 0);len++){\n\t\t\t\t\t\t\tl = client.prioitemsarray[len].id\n\t\t\t\t\t\t\tn = client.prioitemsarray[len].name\n\t\t\t\t\t\t\to = client.prioitemsarray[len].attrib\t\n\t\t\t\t\t\t\t}\n\t\tif(mobarrayprio.includes(n) && o==\"m\"){\n                            set_variable(\"tar\",l)\n                            if(get_variable(\"st_unstoppable\")==\"1\" && get_variable(\"my_rg\")> 14){\n                                send_command(\"rage slice \"+get_variable(\"tar\"))\n                                } \n                              \telse if(client.get_variable(\"st_unstoppable\")==\"0\" && get_variable(\"unstop_can\")==\"1\"){\n                                    send_command(\"rage unstoppable\")\n                                \t}\n                                \telse if(get_variable(\"st_berserk\")==\"0\" && get_variable(\"my_rg\")> 14 && get_variable(\"st_next\")==\"Flare\"){\n                                        send_command(\"rage berserk\")\n                                    \t}\n                                \t\telse {\n                                            send_command(\"rage \"+rage[stance]+\" \"+get_variable(\"tar\"))\n                                            }\n                            }\n        \t\t\t\t\t\n}\n        \n\nif(mobarrayprio.indexOf(n) < 0){\n            //check if should attack or not -normal list\n\t\t\tif(mobarray.includes(y) && z==\"m\"){\n                                    set_variable(\"tar\",x)\n                                    if(get_variable(\"st_unstoppable\")==\"1\" && get_variable(\"my_rg\")> 14){\n                                        send_command(\"rage slice \"+get_variable(\"tar\"))\n                                        } \n                                        else if(get_variable(\"st_unstoppable\")==\"0\" && get_variable(\"unstop_can\")==\"1\"){\n                                            send_command(\"rage unstoppable\")\n