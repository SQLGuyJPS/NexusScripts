ble(\"st_next\")==\"Flare\"){\n                                                                            send_command(\"rage berserk\")\n                                                                            }\n                                                                            else {\n                                                                                send_command(\"rage \"+rage[stance]+\" \"+get_variable(\"tar\"))\n                                                                                }\n                                                        \t\t} //close mobarray\n                                        }//close else\n\n            if(mobarray.indexOf(y) < 0){\n                                    send_GMCP('Char.Items.Room')\n                                    }//close mobarray.indexof(y)\n    \n}//mobarrayprioempty"}],"text":"^You can find no such target.$","matching":"regexp","whole_words":true,"case_sensitive":true},{"type":"alias","name":"add mobs to mobchecklist","enabled":true,"actions":[{"type":"script","enabled":true,"script":"//mobautobash array\nvar mobarray = [];\nvar y = \"\"\nvar txt = '/'\nvar lineend = ''\n\ny = get_variable(\"mobchecklist\") + txt + args[1] + lineend\n\nmobarray.push(y)\n\nvar i, x = \"\"\nfor (i in mobarray){\n    x += mobarray[i];\n    set_variable(\"mobchecklist\",x);\n\tdisplay_notice(\"Mob List: \"+ x);\n}"}],"text":"^mobadd (.+)$","matching":"regexp","whole_words":true,"case_sensitive":true,"prefix_suffix":true},{"type":"alias","name":"remove mobs from mobchecklist","enabled":true,"actions":[{"type":"script","enabled":true,"script":"//mobautobash array\nvar mobarrayold = [];\nvar y = \"\"\n\ny = get_variable(\"mobchecklist\")\nvar x = y.split(\"/\") //changing the string into array\n\nfor (var i=0; i<x.length;i++){\n    x[i]= (x[i])\n}\n\n//Making new array\nvar mobarray = mobarrayold.concat(x);\n//removing last element\nmobarray.pop()\n\n//making new String for mobchecklist variable\nvar z = \"\"\nfor (var i=0; i<mobarray.length;i++) {\n    z +=mobarray[i] + \"/\";   \n}\n\n//removing the last comma\nvar zlen = z.length\nvar cutstring = z.slice(0,z.length-1)\n\n\n//setting last variable\nset_variable(\"mobchecklist\",cutstring)\n\ndisplay_notice(\"Mob Checklist: \"+get_variable(\"mobchecklist\"))\n"}],"text":"mobremove","matching":"begins","whole_words":true,"case_sensitive":true,"prefix_suffix":true},{"type":"alias","name":"add mobs to mobpriochecklist","enabled":true,"actions":[{"type":"script","enabled":true,"script":"//mobautobash array\nvar mobarray = [];\nvar y = \"\"\nvar txt = '/'\nvar lineend = ''\n\ny = get_variable(\"mobpriochecklist\") + txt + args[1] + lineend\n\nmobarray.push(y)\n\nvar i, x = \"\"\nfor (i in mobarray){\n    x += mobarray[i];\n    set_variable(\"mobpriochecklist\",x);\n\tdisplay_notice(\"Mob Prio Checklist: \"+ x);\n}"}],"text":"^mobprioadd (.+)$","matching":"regexp","whole_words":true,"case_sensitive":true,"prefix_suffix":true},{"type":"alias","name":"remove mobs from mobpriochecklist","enabled":true,"actions":[{"type":"script","enabled":true,"script":"//mobautobash array\nvar mobarrayold = [];\nvar y = \"\"\n\ny = get_variable(\"mobpriochecklist\")\nvar x = y.split(\"/\") //changing the string into array\n\nfor (var i=0; i<x.length;i++){\n    x[i]= (x[i])\n}\n\n//Making new array\nvar mobarray = mobarrayold.concat(x);\n//removing last element\nmobarray.pop()\n\n//making new String for mobchecklist variable\nvar z = \"\"\nfor (var i=0; i<mobarray.length;i++) {\n    z +=mobarray[i] + \"/\";   \n}\n\n//removing the last comma\nvar zlen = z.length\nvar cutstring = z.slice(0,z.length-1)\n\n\n//setting last variable\nset_variable(\"mobpriochecklist\",cutstring)\n\ndisplay_notice(\"Mob Prio Checklist: \"+get_variable(\"mobpriochecklist\"))\n"}],"text":"mobprioremove","matching":"begins","whole_words":true,"case_sensitive":true,"prefix_suffix":true},{"type":"alias","name":"see mobchecklist","enabled":true,"actions":[{"type":"script","enabled":true,"script":"//setting up name check array\nset_variable(\"lastkill\",\"0\")\nlet mobarrayold = [];\nlet a = \"\"\n\na = get_variable(\"mobchecklist\")\nlet c = a.split(\"/\") //changing the string into array\n\nfor (let i=0; i<c.length;i++){\n    c[i]= (c[i])\n}\n\n//Making new array -normal\nlet mobarray = mobarrayold.concat(c);\n\n//Making new array - prio\na = get_variable(\"mobpriochecklist\")\nlet b = a.split(\"/\") //changing the string into array\n\nfor (let i=0; i<b.length;i++){\n    b[i]= (b[i])\n}\n\n\nlet mobarrayprio = mobarrayold.concat(b);\n\n//display all Mobs\n\nlet fulllistPrio = mobarrayprio.join(\"\\n\");\nlet fulllistNormal = mobarray.join(\"\\n\");\n\ndisplay_notice(\"Prio Mobs:\"+fulllistPrio,\"#ff8080\")\ndisplay_notice(\"Normal Mobs:\"+fulllistNormal,\"#00e600\")\n\n\n"}],"text":"^moblist$","matching":"regexp","whole_words":true,"case_sensitive":true,"prefix_suffix":true},{"type":"alias","name":"Set Up True Bash 1 time run","enabled":true,"actions":[{"type":"variable","enabled":true,"varname":"@autobash","valtype":"value","value":"0","op":"set"},{"type":"variable","enabled":true,"varname":"@mobchecklist","valtype":"value","value":"-","op":"set"},{"type":"variable","enabled":true,"varname":"@mobpriochecklist","valtype":"value","value":"-","op":"set"},{"type":"variable","enabled":true,"varname":"@selfheal","valtype":"value","value":"1","op":"set"},{"type":"command","enabled":true,"command":"moblist","prefix_suffix":true},{"type":"script","enabled":true,"script":"display_notice(\"**TRUEBASH NOW SET UP - USE 'tb' TO TURN ON AND OFF!\",\"#00cc66\",\"#000000\")\ndisplay_notice(\"There are two mob-checklists that are used in this system - a Priority Checklist for priority targets, and a Normal Checklist for lower priority targets.\",\"#ffb366\",\"#000000\")\ndisplay_notice(\"To add to the Priority List, use 'mobprioadd <insert full mobname here>' (e.g. mobprioadd a sparkling eel)\",\"#ffb366\",\"#000000\")\ndisplay_notice(\"To add to the Normal List, use 'mobadd <insert full mobname here>'  (e.g. mobadd a sparkling eel)\",\"#ffb366\",\"#000000\")\ndisplay_notice(\"To view mobs on both lists, simply use 'moblist'\",\"#ffb366\",\"#000000\")\ndisplay_notice(\"To remove mobs from either list, use 'mobremove' or 'mobprioremove'\",\"#ffb366\",\"#000000\")\ndisplay_notice(\"**Warning: This system ONLY TARGETS MOBS (not players) and does not check for targets entering or leaving a room, nor does it check for aggressive mobs engaging you before starting to engage any valid targets!!\",\"#ff5050\")\n\ndisplay_notice(\"**Warning: This system is fresh for Nexus 3 and can be buggy/overly basic! Please let me (Xuthori) know if you have any comments/suggestions/bugs to report!\",\"#ff5050\")\ndisplay_notice(\"**Warning: Please familiarize yourself with HELP AUTOMATION to use this properly!!\",\"#ff5050\")\n"},{"type":"disableme","enabled":true}],"text":"^setuptruebash$","matching":"regexp","whole_words":true,"case_sensitive":true,"prefix_suffix":true},{"type":"trigger","name":"New Room Trigger - debugging","enabled":false,"actions":[{"type":"if","enabled":true,"cond-type1":"variable","cond-val1":"@truebash","cond-type2":"value","cond-val2":"1","cond-op":"eq","cond-cs":false,"cond-mod":"","dothen":"continue","dothenlabel":"","doelse":"stop","doelselabel":""},{"type":"function","enabled":true,"fn":"onGMCP"},{"type":"script","enabled":true,"script":"//setting up name check array\nclient.set_variable(\"lastkill\",\"0\")\nlet mobarrayold = [];\nlet a = \"\"\n\na = client.get_variable(\"mobchecklist\")\nlet c = a.split(\",\") //changing the string into array\n\nfor (let i=0; i<c.length;i++){\n    c[i]= (c[i])\n}\n\n//Making new array -normal\nlet mobarray = mobarrayold.concat(c);\n\n//Making new array - prio\na = client.get_variable(\"mobpriochecklist\")\nlet b = a.split(\",\") //changing the string into array\n\nfor (let i=0; i<b.length;i++){\n    b[i]= (b[i])\n}\n\n\nlet mobarrayprio = mobarrayold.concat(b);\n\n//check if should attack or not -PRIO first\n\nlet t, l, n, o = \"\";\nt = client.prioitemsarray.length-1\nif (t>-1){\t\n    l = client.prioitemsarray[t].id\n    n = client.prioitemsarray[t].name\n    o = client.prioitemsarray[t].attrib\n}\n\n//setting up the target\nlet g, x, y, z = \"\";\ng = client.itemsarray.length-1\nif (g>-1){\n\tx = client.itemsarray[g].id\n    y = client.itemsarray[g].name\n    z = client.itemsarray[g].attrib\n}\n\ndisplay_notice(\"Normal array:\" + g + \" \" + x + \" \" + y + \" \" + z)\ndisplay_notice(\"Prio array:\" + t + \" \" + l + \" \" + n + \" \" + o)\n\n\nif(mobarrayprio.includes(n) && o==\"m\"){\n\t\t\t\t\t\tclient.set_variable(\"tar\",l)\n                        send_command(\"ff\")\n                        client.set_variable(\"lastkill\",\"prio\")\n\t\t\t\t\t\t} \nelse {\t\n\t\tfor(let len=0;(len<client.prioitemsarray.length)&&(mobarrayprio.indexOf(n) < 0);len++){\n\t\t\t\t\t\t\tl = client.prioitemsarray[len].id\n\t\t\t\t\t\t\tn = client.prioitemsarray[len].name\n\t\t\t\t\t\t\to = client.prioitemsarray[len].attrib\n        \t\t\t\t\tdisplay_notice(\"Prio array:\" + \" \" + l + \" \" + n + \" \" + o +  \"while loop\")\t\n\t\t\t\t\t\t\t}\n\t\tif(mobarrayprio.includes(n) && o==\"m\"){\n                            client.set_variable(\"tar\",l)\n                            send_command(\"ff\")\n                            client.set_variable(\"lastkill\",\"prio\")\n                            }\n        \t\t\t\t\t\n}\n        \n\n\ndisplay_notice(\"Normal array:\" + g + \" \" + x + \" \" + y + \" \" + z + \"After Prio\")\ndisplay_notice(\"Prio array:\" + t + \" \" + l + \" \" + n + \" \" + o +  \"After Prio\")\n\nif(mobarrayprio.indexOf(n) < 0){\n    \t\tdisplay_notice(\"No Attackable Priority Mobs\",\"#ff8080\");\n            //check if should attack or not -normal list\n\t\t\tif(mobarray.includes(y) && z==\"m\"){\n                                    client.set_variable(\"tar\",x)\n                                    send_command(\"ff\")\n                                    client.set_variable(\"lastkill\",\"normal\")\n\t\t\t\t\t\t\t\t\t} \n\t\t\t\t\t\t\t\telse {\t\n                                      \tfor(let len=0;(len<client.itemsarray.length)&&(mobarray.indexOf(y) < 0);len++){\n\t\t\t\t\t\t\t\t\t\t\t\t\tx = client.itemsarray[len].id\n                                                    y = client.itemsarray[len].name\n                                                    z = client.itemsarray[len].attrib\n                                                \tdisplay_notice(\"Normal array:\" + \" \" + x + \" \" + y + \" \" + z + \"while loop\")\n                                                    }\n\t\t\t\t\t\t\t\t\t\tif(mobarray.includes(y) && z==\"m\"){\n                                                        \t\tclient.set_variable(\"tar\",x)\n                                                        \t\tsend_command(\"ff\")\n                                                        \t\tclient.set_variable(\"lastkill\",\"normal\")\n                                                        \t\t} //close mobarray\n                                        }//close else\n\n            if(mobarray.indexOf(y) < 0){\n                                    display_notice(\"No Attackable Mobs\",\"#ffbf80\");\n                                    send_GMCP('Char.Items.Room')\n                                    }//close mobarray.indexof(y)\n    \n}//mobarrayprioempty\n\n\ndisplay_notice(\"Normal array:\" + g + \" \" + x + \" \" + y + \" \" + z + \"After Normal\")\ndisplay_notice(\"Prio array:\" + t + \" \" + l + \" \" + n + \" \" + o +  \"After Normal\")"}],"text":"^You (walk|swim|fly) to the (.+)$","matching":"regexp","whole_words":true,"case_sensitive":true},{"type":"group","name":"Movement","enabled":true,"items":[{"type":"trigger","name":"Autocrash","enabled":true,"actions":[{"type":"script","enabled":true,"script":"send_command(\"crash \" + args[2]);"},{"type":"highlight","enabled":true,"highlight_f