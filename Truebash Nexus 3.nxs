{"type":"group","name":"Truebash N3","enabled":true,"items":[{"type":"function","name":"onLoad","enabled":true,"code":"// Place any code here you'd like to autorun when the system is loaded\n"},{"type":"function","name":"onGMCP","enabled":true,"code":"// Place any code here you'd like to run when a GMCP message is received\n// - The GMCP message is received as \"args.gmcp_method\" and \"args.gmcp_args\"\n\n//getting roominfo for Throw\nif (args.gmcp_method == \"Room.Info\"){\n    client.roomexits = Object.keys(args.gmcp_args.exits);        //remember you can get the room numbers here as well.\n    client.roomnum = args.gmcp_args.num;\n    client.areaname = args.gmcp_args.area;\n    }\n\n//getting Char.Items.List for TrueBash\nif (args.gmcp_method == \"Char.Items.List\"){\n\tclient.itemsarray = (args.gmcp_args.items);\n    client.prioitemsarray = (args.gmcp_args.items);\n} //end Char.Items.List\n\n//getting Char.Vitals for TrueBash\nif (args.gmcp_method == \"Char.Vitals\"){\n  \tlet truebashclass = \"\"\n    truebashclass = (args.gmcp_args.class);\n\tif(get_variable(\"Truebashclass\") != truebashclass) {set_variable(\"Truebashclass\",truebashclass)}\n}\n//End Char.Vitals\n\n//getting Char.Skills.Groups for TrueBash\nif (args.gmcp_method == \"Char.Skills.Groups\"){\n\tclient.skillsarray = (args.gmcp_args);\n} //end Char.Skills.Groups\n\n//getting name for Eng heal zzz\n\nif(get_variable(\"myname\") == \"0\") {\n  if (args.gmcp_method ==\"Char.Status\"){\n\tlet myname = \"\"\n\tmyname = (args.gmcp_args.first_name)\n\tset_variable(\"myname\",myname);\n}\n}\n//end Char.Status stuff\n\n"},{"type":"group","name":"Bashing Auto","enabled":true,"items":[{"type":"alias","name":"ff alias - Start Attacking","enabled":true,"actions":[{"type":"if","enabled":true,"cond-type1":"variable","cond-val1":"@calling","cond-type2":"value","cond-val2":"1","cond-op":"eq","cond-cs":false,"cond-mod":"","dothen":"continue","dothenlabel":"","doelse":"jump","doelselabel":"autobashcheck"},{"type":"command","enabled":true,"command":"crt target: @tar","prefix_suffix":true},{"type":"label","enabled":true,"label":"autobashcheck"},{"type":"if","enabled":true,"cond-type1":"variable","cond-val1":"@autobash","cond-type2":"value","cond-val2":"1","cond-op":"smaller","cond-cs":false,"cond-mod":"","dothen":"continue","dothenlabel":"","doelse":"jump","doelselabel":"swingswing"},{"type":"variable","enabled":true,"varname":"@autobash","valtype":"value","value":"1","op":"set"},{"type":"label","enabled":true,"label":"swingswing"},{"type":"script","enabled":true,"script":"//queue check\nlet queuecheck = \"\"\nqueuecheck = Number(get_variable(\"queueing\"))\n\nif (queuecheck > 0) {set_variable(\"queueing\",\"0\")}\nelse{\n\n//heal check\nlet maxhp = \"\"\nmaxhp = Number(get_variable(\"my_maxhp\"))\nlet currhp = \"\"\ncurrhp = Number(get_variable(\"my_hp\"))\nlet hppercent = \"\"\nhppercent = currhp / maxhp\n\nlet healcheck = \"\"\nhealcheck = hppercent.toFixed(2)\n\nlet selfheal = \"\"\nselfheal = Number(get_variable(\"selfheal\"))\n    \nif (healcheck < 0.80 && selfheal == 1) {send_command(\"dr\")}\n    else{    \n//attack\n    let classatk = \"\"\nlet currclass = \"\"\ncurrclass = get_variable(\"Truebashclass\")\n\nswitch (currclass) {\n case \"Nanoseer\":\n\tclassatk = \"nanopveatk\";\n\tbreak;\n case \"Fury\":\n\tclassatk = \"furypveatk\";\n\tbreak;\n case \"Scoundrel\":\n\tclassatk = \"scounpveatk\";\n\tbreak;\n case \"Engineer\":\n\tclassatk = \"engpveatk\";\n\tbreak;\n case \"B.E.A.S.T.\":\n\tclassatk = \"beastpveatk\";\n\tbreak; \n}\n\nsend_command(classatk)\n    } // end healcheck else\n}//end queuecheck else\n\nif (get_variable(\"autotargetadd\") == \"1\") {\n  let g, x, y = \"\";\n  g = client.itemsarray.length-1\n  if (g>-1){\n    x = client.itemsarray[g].id\n    y = client.itemsarray[g].name\n  } \n  \n  let a = get_variable(\"mobchecklist\")\n  let b = get_variable(\"mobpriochecklist\")\n  let tar = get_variable(\"tar\")\n  let test = +tar\n  \n  if (test != \"NaN\") {\n    if (x == test) {\n      if ((!a.includes(y)) && (!b.includes(y))) {\n      send_command(\"mobprioadd \"+y)\n    }\n  } else {\n      for(let len=0;(len<client.itemsarray.length)&&(x != test);len++){\n\t\t\t\t\t\t\tx = client.itemsarray[len].id\n\t\t\t\t\t\t\ty = client.itemsarray[len].name\n\t\t\t\t\t\t\t}\n\t\tif((!a.includes(y)) && (!b.includes(y))) {\n                      send_command(\"mobprioadd \"+y)\n                        }\n  }\n  }\n}"}],"text":"ff","matching":"begins","whole_words":true,"case_sensitive":false,"prefix_suffix":true},{"type":"trigger","name":"autobash continue","enabled":true,"actions":[{"type":"if","enabled":true,"cond-type1":"variable","cond-val1":"@autobash","cond-type2":"value","cond-val2":"1","cond-op":"eq","cond-cs":false,"cond-mod":"","dothen":"continue","dothenlabel":"","doelse":"stop","doelselabel":""},{"type":"script","enabled":true,"script":"//queue check\nlet queuecheck = \"\"\nqueuecheck = Number(get_variable(\"queueing\"))\n\nif (queuecheck > 0) {set_variable(\"queueing\",\"0\")}\nelse{\n\n//heal check\nlet maxhp = \"\"\nmaxhp = Number(get_variable(\"my_maxhp\"))\nlet currhp = \"\"\ncurrhp = Number(get_variable(\"my_hp\"))\nlet hppercent = \"\"\nhppercent = currhp / maxhp\n\nlet healcheck = \"\"\nhealcheck = hppercent.toFixed(2)\n\nlet selfheal = \"\"\nselfheal = Number(get_variable(\"selfheal\"))\n    \nif (healcheck < 0.80 && selfheal == 1) {send_command(\"dr\")}\n    else{    \n//attack\n    let classatk = \"\"\nlet currclass = \"\"\ncurrclass = get_variable(\"Truebashclass\")\n\nswitch (currclass) {\n case \"Nanoseer\":\n\tclassatk = \"nanopveatk\";\n\tbreak;\n case \"Fury\":\n\tclassatk = \"furypveatk\";\n\tbreak;\n case \"Scoundrel\":\n\tclassatk = \"scounpveatk\";\n\tbreak;\n case \"Engineer\":\n\tclassatk = \"engpveatk\";\n\tbreak;\n case \"B.E.A.S.T.\":\n\tclassatk = \"beastpveatk\";\n\tbreak; \n}\n\nsend_command(classatk)\n    } // end healcheck else\n}//end queuecheck else"}],"text":"You have recovered your balance.","matching":"begins","whole_words":true,"case_sensitive":true},{"type":"trigger","name":"autobash continue","enabled":false,"actions":[{"type":"if","enabled":true,"cond-type1":"variable","cond-val1":"@autobash","cond-type2":"value","cond-val2":"1","cond-op":"eq","cond-cs":false,"cond-mod":"","dothen":"continue","dothenlabel":"","doelse":"stop","doelselabel":""},{"type":"script","enabled":true,"script":"//queue check\nlet queuecheck = \"\"\nqueuecheck = Number(get_variable(\"queueing\"))\n\nif (queuecheck > 0) {set_variable(\"queueing\",\"0\")}\nelse{\n\n//heal check\nlet maxhp = \"\"\nmaxhp = Number(get_variable(\"my_maxhp\"))\nlet currhp = \"\"\ncurrhp = Number(get_variable(\"my_hp\"))\nlet hppercent = \"\"\nhppercent = currhp / maxhp\n\nlet healcheck = \"\"\nhealcheck = hppercent.toFixed(2)\n\nlet selfheal = \"\"\nselfheal = Number(get_variable(\"selfheal\"))\n    \nif (healcheck < 0.80 && selfheal == 1) {send_command(\"void embrace\")}\n    else{    \n//attack\n    send_command(\"void freeze \" + get_variable(\"tar\"))\n    } // end healcheck else\n}//end queuecheck else"}],"text":"You have recovered your balance.","matching":"begins","whole_words":true,"case_sensitive":true},{"type":"trigger","name":"autobash continue (confusion)","enabled":false,"actions":[{"type":"if","enabled":true,"cond-type1":"variable","cond-val1":"@autobash","cond-type2":"value","cond-val2":"1","cond-op":"eq","cond-cs":false,"cond-mod":"","dothen":"continue","dothenlabel":"","doelse":"stop","doelselabel":""},{"type":"script","enabled":true,"script":"//queue check\nlet queuecheck = \"\"\nqueuecheck = Number(client.get_variable(\"queueing\"))\n\nif (queuecheck > 0) { client.set_variable(\"queueing\",\"0\")}\nelse{\n\n//heal check\nlet maxhp = \"\"\nmaxhp = Number(client.get_variable(\"my_maxhp\"))\nlet currhp = \"\"\ncurrhp = Number(client.get_variable(\"my_hp\"))\nlet hppercent = \"\"\nhppercent = currhp / maxhp\n\nlet healcheck = \"\"\nhealcheck = hppercent.toFixed(2)\n\nlet selfheal = \"\"\nselfheal = Number(client.get_variable(\"selfheal\"))\n    \nif (healcheck < 0.80 && selfheal == 1) {send_command(\"void embrace\")}\n    else{    \n//attack\n    send_command(\"void freeze \" + client.get_variable(\"tar\"))\n    } // end healcheck else\n}//end queuecheck else"}],"text":"You attempt to launch an attack but fail and hurt yourself in your confusion!","matching":"begins","whole_words":true,"case_sensitive":true},{"type":"trigger","name":"BEING ATTACKED","enabled":true,"actions":[{"type":"highlight","enabled":true,"highlight_fg":"#ff0000","highlight_bg":"#ffff00","highlight":"match","highlight_backref":"1"}],"text":"moves in to attack you.","matching":"substring","whole_words":true,"case_sensitive":true},{"type":"alias","name":"Raze Script","enabled":true,"actions":[{"type":"script","enabled":true,"script":"let classint = \"\"\nlet currclass = \"\"\ncurrclass = get_variable(\"Truebashclass\")\nlet tar = get_variable(\"tar\")\n\nswitch (currclass) {\n case \"Nanoseer\":\n\tclassint = \"nano eyestrike \";\n\tbreak;\n case \"Fury\":\n\tclassint = \"kith fever \";\n\tbreak;\n case \"Scoundrel\":\n\tif (get_variable(\"my_bl\") > 0) {classint = \"gun pointblank \"} else {classint = \"guile pocketsand \"};\n\tbreak;\n case \"Engineer\":\n\tclassint = \"gadget shock \";\n\tbreak;\n case \"B.E.A.S.T.\":\n\tclassint = \"plasma flash \";\n\tbreak; \n}\n\nsend_command(classint + tar)"}],"text":"^rr$","matching":"regexp","whole_words":true,"case_sensitive":false,"prefix_suffix":true},{"type":"trigger","name":"Kill msg","enabled":true,"actions":[{"type":"highlight","enabled":true,"highlight_fg":"#ff0000","highlight_bg":"#ffff00","highlight":"match","highlight_backref":"1"},{"type":"variable","enabled":true,"varname":"@windup","valtype":"value","value":"0","op":"set"},{"type":"variable","enabled":true,"varname":"@queueing","valtype":"value","value":"0","op":"set"}],"text":"You have slain a","matching":"substring","whole_words":false,"case_sensitive":true},{"type":"trigger","name":"killed","enabled":true,"actions":[{"type":"highlight","enabled":true,"highlight_fg":"#ff0000","highlight_bg":"#ffff00","highlight":"match","highlight_backref":"1"},{"type":"variable","enabled":true,"varname":"@autobash","valtype":"value","value":"0","op":"set"},{"type":"variable","enabled":true,"varname":"@queueing","valtype":"value","value":"0","op":"set"}],"text":"has been slain by","matching":"substring","whole_words":false,"case_sensitive":false},{"type":"trigger","name":"killed","enabled":true,"actions":[{"type":"highlight","enabled":true,"highlight_fg":"#ff0000","highlight_bg":"#ffff00","highlight":"match","highlight_backref":"1"},{"type":"variable","enabled":true,"varname":"@autobash","valtype":"value","value":"0","op":"set"}],"text":"You have slain","matching":"substring","whole_words":false,"case_sensitive":false},{"type":"trigger","name":"Queue Check","enabled":true,"actions":[{"type":"if","enabled":true,"cond-type1":"variable","cond-val1":"@autobash","cond-type2":"value","cond-val2":"1","cond-op":"eq","cond-cs":false,"cond-mod":"","dothen":"continue","dothenlabel":"","doelse":"stop","doelselabel":""},{"type":"variable","enabled":true,"varname":"@queueing","valtype":"value","value":"1","op":"set"}],"text":"[Queue]: You will attempt to","matching":"begins","whole_words":false,"case_sensitive":false},{"type":"alias","name":"autobash off","enabled":true,"actions":[{"type":"variable","enabled":true,"varname":"@autobash","valtype":"value","value":"0","op":"set"},{"type":"variable","enabled":true,"varname":"@aff_hypertension","valtype":"value","value":"0","op":"set"},{"type":"variable","enabled":true,"varname":"@st_berserk","valtype":"value","value":"0","op":"set"},{"type":"variable","enabled":true,"varname":"@st_overpower","valtype":"value","value":"0","op":"set"},{"type":"notify","enabled":true,"notice":"**AB RESET**","notice_fg":"#ace0fc","notice_bg":"#000000"}],"text":"ahoff","matching":"begins","whole_words":true,"case_sensitive":false,"prefix_suffix":true},{"type":"alias","name":"Nanoseer PVE Attack","enabled":true,"actions":[{"type":"script","enabled":true,"script":"let narank = Number(get_variable(\"NanotechRank\"))\nlet vorank = Number(get_variable(\"VoidismRank\"))\nlet obrank = Number(get_variable(\"OblivionRank\"))\nlet atk = \"\"\nlet tar = get_variable(\"tar\")\nif (GMCP.Defences[\"Oblivion: Conqueror\"] && get_variable(\"channel_conqueror\") != \"1\") {\n  \tset_variable(\"channel_conqueror\",\"1\");\n\tset_variable(\"channel_traveller\",\"0\");\n  \tset_variable(\"channel_progenitor\",\"0\");\n} else if (GMCP.Defences[\"Oblivion: Traveller\"] && get_variable(\"channel_traveller\") != \"1\") {\n  \tset_variable(\"channel_conqueror\",\"0\");\n\tset_variable(\"channel_traveller\",\"1\");\n  \tset_variable(\"channel_progenitor\",\"0\");\n} else if (GMCP.Defences[\"Oblivion: Progenitor\"] && get_variable(\"channel_progenitor\") != \"1\") {\n  \tset_variable(\"channel_conqueror\",\"0\");\n\tset_variable(\"channel_traveller\",\"0\");\n  \tset_variable(\"channel_progenitor\",\"1\");\n}\n\nif (vorank > 14 && get_variable(\"pointzero_got\") == \"0\") {\n\tatk = \"void pointzero\"\n\t} else if (obrank > 20 && get_variable(\"speedup_got\") == \"0\" && get_variable(\"speedup_avail\") == \"1\") {\n\t\tif (get_variable(\"channel_traveller\") == \"1\" || get_variable(\"affinity_traveller\") == \"1\") {atk = \"oblivion speedup\"}\n\t\t} else if (obrank >17 && get_variable(\"frenzy_got\") == \"0\" && get_variable(\"frenzy_avail\") == \"1\") {\n\t\t\tif (get_variable(\"channel_conqueror\") == \"1\" || get_variable(\"affinity_conqueror\") == \"1\") {atk = \"oblivion frenzy\"}\n\t\t\t} else {atk = \"void freeze \" + tar}\n\nsend_command(atk)\n"}],"text":"nanopveatk","matching":"exact","whole_words":true,"case_sensitive":true,"prefix_suffix":true},{"type":"alias","name":"Engineer PVE Attack","enabled":true,"actions":[{"type":"script","enabled":true,"script":"let btrank = Number(get_variable(\"BotsRank\"))\nlet trrank = Number(get_variable(\"TurretsRank\"))\nlet gdrank = Number(get_variable(\"GadgetsRank\"))\nlet atk = \"\"\nlet tar = get_variable(\"tar\")\n\nif (btrank > 29) {atk = \"bot disrupt \" + tar} else\n\t\tif (btrank > 0) {atk = \"bot claw \" + tar} else\n          display_notice(\"No valid skills detected. Please visit your battlemaster via WALK TO ENGINEER and learn at least 5 BOTS from Sprocket\")\n\n// ---- Turret power management (see group \"Turret Power (Engineer)\"; toggle with tmode) ----\nlet turretBoost = false\nif (get_variable(\"turretmode\") == \"1\") {\n  let now = Date.now()\n  let gap = now - (Number(get_variable(\"turret_lastcheck\")) || 0)\n  if (gap > 45000) {   // resync with the real charge every 45s\n    set_variable(\"turret_opening\", gap > 120000 ? \"1\" : \"0\")   // long pause = new fight: top up to 100%\n    set_variable(\"turret_lastcheck\", String(now))\n    send_command(\"turret status\")\n  }\n  let cost = parseFloat(get_variable(\"turret_cost\")); if (isNaN(cost)) cost = 15\n  let charge = parseFloat(get_variable(\"turret_charge\")); if (isNaN(charge)) charge = 100\n  let margin = Number(get_variable(\"turret_margin\")) || 1\n  let lastsent = Number(get_variable(\"turret_lastboostsent\")) || 0\n  if ((get_variable(\"turret_needboost\") == \"1\" || charge < cost * margin) && now - lastsent > 6000) {\n    let fails = Number(get_variable(\"turret_boostfails\")) || 0\n    if (fails >= 3) {   // three boosts with no confirmation: no turret / no QPC / something wrong\n      set_variable(\"turretmode\", \"0\")\n      set_variable(\"turret_needboost\", \"0\")\n      display_notice(\"Turret power: 3 boosts without confirmation - turret mode OFF (type tmode to re-enable)\", \"#ff5050\")\n    } else {\n      turretBoost = true\n      set_variable(\"turret_boostfails\", String(fails + 1))\n      set_variable(\"turret_lastboostsent\", String(now))\n    }\n  }\n}\n// ---- end turret power management ----\n\nif (turretBoost) { send_command(\"turret qpcboost\") } else { send_command(atk) }"}],"text":"engpveatk","matching":"exact","whole_words":true,"case_sensitive":true,"prefix_suffix":true},{"type":"alias","name":"BEAST PVE Attack","enabled":true,"actions":[{"type":"script","enabled":true,"script":"let pcrank = Number(get_variable(\"PlasmaCastingRank\"))\nlet mwprank = Number(get_variable(\"MWPRank\"))\nlet strank = Number(get_variable(\"SuitTechRank\"))\nlet atk = \"\"\nlet tar = get_variable(\"tar\")\n\n\nif (mwprank > 29 && get_variable(\"dualshot_avail\") == \"1\" && get_variable(\"rails_avail\") == \"1\") {\n\tatk = \"MWP dualshot \" + tar + \" headshot headshot\"\n\t} else if (mwprank > 13 && get_variable(\"rails_avail\") == \"1\") {\n\t\tatk = \"mwp headshot \" + tar\n\t\t} else if (mwprank > 25) {\n\t\t\tatk = \"mwp tear \" + tar\n\t\t\t} else if (pcrank > 10 && get_variable(\"nozzle_state\") != \"wide\") {\n\t\t\t\tatk = \"plasma nozzle wide\"\n\t\t\t\t} else if (pcrank > 1) {\n\t\t\t\t\tatk = \"plasma burn \" + tar\n\t\t\t\t\t} else {atk = \"mwp wristblade \" + tar}\n\nsend_command(atk)"}],"text":"beastpveatk","matching":"exact","whole_words":true,"case_sensitive":true,"prefix_suffix":true},{"type":"alias","name":"Scoundrel PVE Attack","enabled":true,"actions":[{"type":"script","enabled":true,"script":"let bullets = Number(get_variable(\"my_bl\"))\nlet gsrank = Number(get_variable(\"GunslingingRank\"))\nlet gurank = Number(get_variable(\"GuileRank\"))\nlet imrank = Number(get_variable(\"ImprovisationRank\"))\nlet atk = \"\"\nlet tar = get_variable(\"tar\")\nlet rippers = Number(get_variable(\"ripper_avail\"))\n\n//reload atk\nif (bullets == \"0\") {\n\tif (imrank > 5 && rippers > 0) {\n\t\tatk = \"ied fling ripper at \"+tar\n\t\t} else if (gsrank > 14) {\n\t\t\t\t\tatk = \"gun spin\"\n\t\t\t\t\t} else if (gurank > 4) {\n\t\t\t\t\t\t\t\tatk = \"guile pocketsand \"+tar\n\t\t\t\t\t\t\t\t} else if (gsrank > 1) {\n\t\t\t\t\t\t\t\t\t\t\tatk = \"gun quickload\"\n\t\t\t\t\t\t\t\t\t\t\t} else {atk = \"guile haymaker \"+tar}\n\t} else {   //start of bullet attack\n\t\tif (gsrank > 19 && get_variable(\"ambush_avail\") == \"1\") {\n          \tatk = \"gun ambush \"+tar\n        \tset_variable(\"prev_atk\",\"ambush\");\n        \t} else\n\t\tif (gsrank > 12 && bullets > 1 && get_variable(\"rapidfire_avail\") == \"1\") {\n          \tatk = \"gun rapidfire \" +tar\n        \tset_variable(\"prev_atk\",\"rapidfire\");\n        \t} else \n\t\tif (gsrank > 0) {\n          \tatk = \"gun crackshot \"+tar\n        \t} else {\t\n              atk = \"guile haymaker \"+tar\n            }\n\t}\n\n\nsend_command(atk)"}],"text":"scounpveatk","matching":"exact","whole_words":true,"case_sensitive":true,"prefix_suffix":true},{"type":"alias","name":"Fury PVE Attack","enabled":true,"actions":[{"type":"script","enabled":true,"script":"//Get Skills\nlet flrank = Number(get_variable(\"FulminationRank\"))\nlet bfrank = Number(get_variable(\"BattleflowRank\"))\nlet rgrank = Number(get_variable(\"RageRank\"))\n\n// Combos\nlet stance = get_variable(\"my_st\")\nlet tar = get_variable(\"tar\")\nlet blade = {\n\t\t'Symmetry'\t:\t'assault',\n    \t\t'Spark'\t\t:\t'hew',\n    \t\t'Ember'\t\t:\t'legspike',\n        \t'Blaze'\t\t:\t'barrage',\n    \t\t'Eruption'\t:\t'rupture',\n    \t\t'Flare'\t\t:\t'sear',\n    \t\t'Inferno'\t:\t'rend'\n}\n\nif (bfrank > 28 && get_variable(\"aff_hypertension\")==\"1\") {blade[\"Eruption\"]=\"bloodburn\"} else //can also do blade.Eruption = \"bloodburn\"\n  if (bfrank > 20) {blade[\"Eruption\"]=\"hypertension\"} else\n    if (bfrank > 7 && rgrank > 24) {blade[\"Flare\"]=\"wound\"} else\n      if (bfrank > 6 && rgrank > 6) {blade[\"Symmetry\"]=\"gutrend\"} else\n        if (bfrank > 5 && rgrank >3) {blade[\"Symmetry\"]=\"swiftcut\"}\n          \n\n\n\nlet atk = \"\"\natk = \"combo \" + blade[stance] + \" \"\n\nlet nextstance = {\n    'gutrend'\t\t:\t'Flare',\n    'sear'\t\t\t:\t'Symmetry',\n    'swiftcut'\t\t:\t'Ember',\n    'legspike'\t\t:\t'Symmetry',\n    'sweep'\t\t\t:\t'Spark',\n    'assail'\t\t:\t'Blaze',\n    'bombard'\t\t:\t'Ember',\n    'cripple'\t\t:\t'Ember',\n    'barrage'\t\t:\t'Ember',\n    'raindown'\t\t:\t'Ember',\n    'heartrend'\t\t:\t'Ember',\n    'hew'\t\t\t:\t'Ember',\n    'salvo'\t\t\t:\t'Ember',\n    'sting'\t\t\t:\t'Ember',\n    'blitz'\t\t\t:\t'Ember',\n    'flamebound'\t:\t'Ember',\n    'asymmetry'\t\t:\t'Flare',\n    'rupture'\t\t:\t'Flare',\n    'hypertension'\t:\t'Flare',\n    'bloodsinge'\t:\t'Flare',\n    'bloodburn'\t\t:\t'Flare',\n    'concuss'\t\t:\t'Flare',\n    'pummel'\t\t:\t'Flare',\n    'cleave'\t\t:\t'Flare',\n    'rend'\t\t\t:\t'Flare',\n    'sunder'\t\t:\t'Flare',\n    'wound'\t\t\t:\t'Eruption',\n    'drive'\t\t\t:\t'Inferno',\n  \t'assault'\t\t:\t'Symmetry',\n}\n\nlet bladeatk = blade[stance]\nlet nextstancerage = nextstance[bladeatk]\n\nlet rage = {\n\t\t'Symmetry'\t:\t'strike',\n    \t\t'Spark'\t\t:\t'topple',\n    \t\t'Ember'\t\t:\t'upperlash',\n        \t'Blaze'\t\t:\t'airflip',\n    \t\t'Eruption'\t:\t'deepstrike',\n    \t\t'Flare'\t\t:\t'flyinglash',\n    \t\t'Inferno'\t:\t'daze'\n}\n\nlet rageatk = \"\"\n\nlet unstopatkrage = {\n\t\t'OVERWHELM'\t:\t'overwhelm',\n\t\t'TWIST'\t\t:\t'twist',\n\t\t'SLICE'\t\t:\t'slice'\n}\n\nlet unstopatk = \"SLICE\"\n\n// set if checks - if can unstop then unstop; if can berserk then berserk, then slice away for this rotation\n\nif (get_variable(\"unstop_can\")==\"1\" && rgrank > 13) {rageatk=\"unstoppable\"} else{\n\tif(get_variable(\"st_unstoppable\")==\"1\" && Number(get_variable(\"my_rg\"))>4) {rageatk = \"slice\"} else {\n    \tif(Number(get_variable(\"my_rg\"))>4 && get_variable(\"st_berserk\")==\"0\" && nextstancerage == \"Flare\" && rgrank > 17) {rageatk = \"berserk\"} else {\n\t\t\trageatk = rage[nextstancerage]\n        \t}\n\t\t}\n\t}\n\natk += rageatk\n\nlet kithbladeatk = \"\"\nkithbladeatk = atk + \" \"\n\nlet fuatk = \"\"\nfuatk = \"kith burn \"\n\nlet furyatk = \"\"\n\nif (bfrank > 2 && rgrank > 1) {furyatk = kithbladeatk} else {furyatk = fuatk}\n\nsend_command(furyatk + tar)\n"}],"text":"furypveatk","matching":"exact","whole_words":true,"case_sensitive":true,"prefix_suffix":true},{"type":"alias","name":"BEAST PVE Attack (burn)","enabled":false,"actions":[{"type":"script","enabled":true,"script":"let pcrank = Number(get_variable(\"PlasmaCastingRank\"))\nlet mwprank = Number(get_variable(\"MWPRank\"))\nlet strank = Number(get_variable(\"SuitTechRank\"))\nlet atk = \"\"\nlet tar = get_variable(\"tar\")\n\n\nif (pcrank > 10 && get_variable(\"nozzle_state\") != \"wide\") {\n\t\t\t\tatk = \"plasma nozzle wide\"\n\t\t\t\t} else if (pcrank > 1) {\n\t\t\t\t\tatk = \"plasma burn \" + tar\n\t\t\t\t\t} else {atk = \"mwp wristblade \" + tar}\n\nsend_command(atk)"}],"text":"beastpveatk","matching":"exact","whole_words":true,"case_sensitive":true,"prefix_suffix":true}]},{"type":"group","name":"Turret Power (Engineer)","enabled":true,"description":"Tracks turret charge and spends a free balance on 'turret qpcboost' when the next shot would fail. Toggle with 'tmode'. Edit-in-place logic also lives at the top of 'engpveatk' (Bashing Auto).","items":[{"type":"alias","name":"Turret mode toggle","enabled":true,"actions":[{"type":"script","enabled":true,"script":"let on = get_variable(\"turretmode\") == \"1\"\nset_variable(\"turretmode\", on ? \"0\" : \"1\")\nif (on) {\n  display_notice(\"Turret power management: OFF\", \"#ff5050\")\n} else {\n  set_variable(\"turret_boostfails\", \"0\")\n  set_variable(\"turret_needboost\", \"0\")\n  display_notice(\"Turret power management: ON\", \"#a1ff5b\")\n}"}],"text":"tmode","matching":"exact","whole_words":true,"case_sensitive":true,"prefix_suffix":true},{"type":"trigger","name":"Turret fires shot","enabled":true,"actions":[{"type":"script","enabled":true,"script":"// Turret fired a shot: subtract its energy cost from our tracked charge\nlet owner = args[1]\nlet me = get_variable(\"myname\")\nif (get_variable(\"turretmode\") == \"1\" && (!me || me == \"0\" || owner.toLowerCase() == me.toLowerCase())) {\n  let cost = parseFloat(get_variable(\"turret_cost\")); if (isNaN(cost)) cost = 15\n  let charge = parseFloat(get_variable(\"turret_charge\")); if (isNaN(charge)) charge = 100\n  set_variable(\"turret_charge\", String(Math.max(0, charge - cost)))\n}"}],"text":"^.*?(\\w+)'s (\\w+) turret, \\w+ into .+\\.$","matching":"regexp","whole_words":true,"case_sensitive":true},{"type":"trigger","name":"Turret boost completed","enabled":true,"actions":[{"type":"script","enabled":true,"script":"// qpcboost finished: turret is back to full\nset_variable(\"turret_charge\", \"100\")\nset_variable(\"turret_needboost\", \"0\")\nset_variable(\"turret_boostfails\", \"0\")"}],"text":"^Socketing the QPC into the modular charging port","matching":"regexp","whole_words":true,"case_sensitive":true},{"type":"trigger","name":"Turret out of power","enabled":true,"actions":[{"type":"script","enabled":true,"script":"// Safety net: turret tried to fire with no power. Flag it; the next balance recovery\n// (after the heal check) spends its action on qpcboost.\nif (get_variable(\"turretmode\") == \"1\") {\n  set_variable(\"turret_charge\", \"0\")\n  set_variable(\"turret_needboost\", \"1\")\n}"}],"text":"^A deployed turret .*enough power to attack","matching":"regexp","whole_words":true,"case_sensitive":true},{"type":"trigger","name":"Turret status - charge","enabled":true,"actions":[{"type":"script","enabled":true,"script":"set_variable(\"turret_charge\", String(Number(args[1])))"}],"text":"^It is charged at (\\d+)%\\.$","matching":"regexp","whole_words":true,"case_sensitive":true},{"type":"trigger","name":"Turret status - cost","enabled":true,"actions":[{"type":"script","enabled":true,"script":"// Last line we need from \"turret status\". The status reply is authoritative.\nlet cost = Number(args[1])\nlet charge = Number(get_variable(\"turret_charge\"))\nlet opening = get_variable(\"turret_opening\") == \"1\"\nset_variable(\"turret_cost\", String(cost))\nset_variable(\"turret_opening\", \"0\")\n// Need a boost if the turret cannot fire, or (at the start of a fight) is not full\nlet need = (charge < cost) || (opening && charge < 100)\nset_variable(\"turret_needboost\", need ? \"1\" : \"0\")"}],"text":"^It requires (\\d+)% energy per shot\\.$","matching":"regexp","whole_words":true,"case_sensitive":true}]},{"type":"group","name":"TrueBash","enabled":true,"items":[{"type":"alias","name":"ff alias - Start Attacking","enabled":false,"actions":[{"type":"label","enabled":true,"label":"autobashcheck"},{"type":"if","enabled":true,"cond-type1":"variable","cond-val1":"@autobash","cond-type2":"value","cond-val2":"1","cond-op":"smaller","cond-cs":false,"cond-mod":"","dothen":"continue","dothenlabel":"","doelse":"jump","doelselabel":"heal"},{"type":"variable","enabled":true,"varname":"@autobash","valtype":"value","value":"1","op":"set"},{"type":"label","enabled":true,"label":"heal"},{"type":"if","enabled":true,"cond-type1":"variable","cond-val1":"@my_hp","cond-type2":"value","cond-val2":"4500","cond-op":"smaller","cond-cs":false,"cond-mod":"","dothen":"continue","dothenlabel":"","doelse":"jump","doelselabel":"pvebleed"},{"type":"if","enabled":true,"cond-type1":"variable","cond-val1":"@selfheal","cond-type2":"value","cond-val2":"1","cond-op":"eq","cond-cs":false,"cond-mod":"","dothen":"continue","dothenlabel":"","doelse":"jump","doelselabel":"pvebleed"},{"type":"command","enabled":true,"command":"dr","prefix_suffix":true},{"type":"stop","enabled":true},{"type":"label","enabled":true,"label":"pvebleed"},{"type":"command","enabled":true,"command":"bld","prefix_suffix":true},{"type":"stop","enabled":true}],"text":"ff","matching":"begins","whole_words":true,"case_sensitive":false,"prefix_suffix":true},{"type":"trigger","name":"killed","enabled":false,"actions":[{"type":"highlight","enabled":true,"highlight_fg":"#ff0000","highlight_bg":"#ffff00","highlight":"match","highlight_backref":"1"},{"type":"variable","enabled":true,"varname":"@autobash","valtype":"value","value":"0","op":"set"}],"text":"You have slain","matching":"substring","whole_words":false,"case_sensitive":false},{"type":"alias","name":"truebash trigger on off","enabled":true,"actions":[{"type":"if","enabled":true,"cond-type1":"variable","cond-val1":"@truebash","cond-type2":"value","cond-val2":"0","cond-op":"eq","cond-cs":false,"cond-mod":"","dothen":"continue","dothenlabel":"","doelse":"jump","doelselabel":"truebashoff"},{"type":"variable","enabled":true,"varname":"@truebash","valtype":"value","value":"1","op":"set"},{"type":"notify","enabled":true,"notice":"**TRUEBASH IS ON**","notice_fg":"#a1ff5b","notice_bg":"#000000"},{"type":"stop","enabled":true},{"type":"label","enabled":true,"label":"truebashoff"},{"type":"if","enabled":true,"cond-type1":"variable","cond-val1":"@truebash","cond-type2":"value","cond-val2":"0","cond-op":"eq","cond-cs":false,"cond-mod":"not","dothen":"continue","dothenlabel":"","doelse":"stop","doelselabel":""},{"type":"variable","enabled":true,"varname":"@truebash","valtype":"value","value":"0","op":"set"},{"type":"notify","enabled":true,"notice":"**TRUEBASH IS OFF**","notice_fg":"#ff0000","notice_bg":"#000000"},{"type":"stop","enabled":true}],"text":"tb","matching":"exact","whole_words":false,"case_sensitive":false,"prefix_suffix":true},{"type":"trigger","name":"New Room Trigger","enabled":true,"actions":[{"type":"if","enabled":true,"cond-type1":"variable","cond-val1":"@truebash","cond-type2":"value","cond-val2":"1","cond-op":"eq","cond-cs":false,"cond-mod":"","dothen":"continue","dothenlabel":"","doelse":"stop","doelselabel":""},{"type":"if","enabled":true,"cond-type1":"variable","cond-val1":"speedwalking","cond-type2":"value","cond-val2":"0","cond-op":"eq","cond-cs":false,"cond-mod":"is","dothen":"continue","dothenlabel":"","doelse":"stop","doelselabel":""},{"type":"function","enabled":true,"fn":"onGMCP"},{"type":"script","enabled":true,"script":"//setting up name check array\nlet mobarrayold = [];\nlet a = \"\"\n\na = get_variable(\"mobchecklist\")\nlet c = a.split(\"/\") //changing the string into array\n\nfor (let i=0; i<c.length;i++){\n    c[i]= (c[i])\n}\n\n//Making new array -normal\nlet mobarray = mobarrayold.concat(c);\n\n//Making new array - prio\na = get_variable(\"mobpriochecklist\")\nlet b = a.split(\"/\") //changing the string into array\n\nfor (let i=0; i<b.length;i++){\n    b[i]= (b[i])\n}\n\n\nlet mobarrayprio = mobarrayold.concat(b);\n\n//check if should attack or not -PRIO first\n\nlet t, l, n, o = \"\";\nt = client.prioitemsarray.length-1\nif (t>-1){\t\n    l = client.prioitemsarray[t].id\n    n = client.prioitemsarray[t].name\n    o = client.prioitemsarray[t].attrib\n}\n\n//setting up the target\nlet g, x, y, z = \"\";\ng = client.itemsarray.length-1\nif (g>-1){\n\tx = client.itemsarray[g].id\n    y = client.itemsarray[g].name\n    z = client.itemsarray[g].attrib\n}\n\n\nif(mobarrayprio.includes(n) && o==\"m\"){\n\t\t\t\t\t\tset_variable(\"tar\",l)\n                        send_command(\"ff\")\n\t\t\t\t\t\t} \nelse {\t\n\t\tfor(let len=0;(len<client.prioitemsarray.length)&&(mobarrayprio.indexOf(n) < 0);len++){\n\t\t\t\t\t\t\tl = client.prioitemsarray[len].id\n\t\t\t\t\t\t\tn = client.prioitemsarray[len].name\n\t\t\t\t\t\t\to = client.prioitemsarray[len].attrib\t\n\t\t\t\t\t\t\t}\n\t\tif(mobarrayprio.includes(n) && o==\"m\"){\n                            set_variable(\"tar\",l)\n                            send_command(\"ff\")\n                            }\n        \t\t\t\t\t\n}\n        \n\nif(mobarrayprio.indexOf(n) < 0){\n            //check if should attack or not -normal list\n\t\t\tif(mobarray.includes(y) && z==\"m\"){\n                                    set_variable(\"tar\",x)\n                                    send_command(\"ff\")\n\t\t\t\t\t\t\t\t\t} \n\t\t\t\t\t\t\t\telse {\t\n                                      \tfor(let len=0;(len<client.itemsarray.length)&&(mobarray.indexOf(y) < 0);len++){\n\t\t\t\t\t\t\t\t\t\t\t\t\tx = client.itemsarray[len].id\n                                                    y = client.itemsarray[len].name\n                                                    z = client.itemsarray[len].attrib\n                                                    }\n\t\t\t\t\t\t\t\t\t\tif(mobarray.includes(y) && z==\"m\"){\n                                                        \t\tset_variable(\"tar\",x)\n                                                        \t\tsend_command(\"ff\")\n                                                        \t\t} //close mobarray\n                                        }//close else\n\n            if(mobarray.indexOf(y) < 0){\n                                    nexusclient.add_html_line('<span class=\"xc-CornflowerBlue\"> [No Valid Mobs] </span>');\n                                    send_GMCP('Char.Items.Room')\n                                    }//close mobarray.indexof(y)\n    \n}//mobarrayprioempty"}],"text":"^(.+)NPCs(.+)$","matching":"regexp","whole_words":true,"case_sensitive":true},{"type":"trigger","name":"Kill check bash","enabled":true,"actions":[{"type":"if","enabled":true,"cond-type1":"variable","cond-val1":"@truebash","cond-type2":"value","cond-val2":"1","cond-op":"eq","cond-cs":false,"cond-mod":"","dothen":"continue","dothenlabel":"","doelse":"stop","doelselabel":""},{"type":"script","enabled":true,"script":"send_GMCP('Char.Items.Room')"},{"type":"function","enabled":true,"fn":"onGMCP"},{"type":"waitfor","enabled":true,"text":"^You have recovered your balance.$","matching":"regexp","whole_words":false,"case_sensitive":false,"expire":"4"},{"type":"script","enabled":true,"script":"//setting up name check array\nlet mobarrayold = [];\nlet a = \"\"\n\na = get_variable(\"mobchecklist\")\nlet c = a.split(\"/\") //changing the string into array\n\nfor (let i=0; i<c.length;i++){\n    c[i]= (c[i])\n}\n\n//Making new array -normal\nlet mobarray = mobarrayold.concat(c);\n\n//Making new array - prop\na = get_variable(\"mobpriochecklist\")\nlet b = a.split(\"/\") //changing the string into array\n\nfor (var i=0; i<b.length;i++){\n    b[i]= (b[i])\n}\n\n\nlet mobarrayprio = mobarrayold.concat(b);\n\n\n//check if should attack or not -PRIO first\n\nlet t, l, n, o = \"\";\nt = client.prioitemsarray.length-1\nif (t>-1){\t\n    l = client.prioitemsarray[t].id\n    n = client.prioitemsarray[t].name\n    o = client.prioitemsarray[t].attrib\n}\n\n//setting up the target\nlet g, x, y, z = \"\";\ng = client.itemsarray.length-1\nif (g>-1){\n\tx = client.itemsarray[g].id\n    y = client.itemsarray[g].name\n    z = client.itemsarray[g].attrib\n}\n\n\nif(mobarrayprio.includes(n) && o==\"m\"){\n\t\t\t\t\t\tset_variable(\"tar\",l)\n                        send_command(\"ff\")\n\t\t\t\t\t\t} \nelse {\t\n\t\tfor(let len=0;(len<client.prioitemsarray.length)&&(mobarrayprio.indexOf(n) < 0);len++){\n\t\t\t\t\t\t\tl = client.prioitemsarray[len].id\n\t\t\t\t\t\t\tn = client.prioitemsarray[len].name\n\t\t\t\t\t\t\to = client.prioitemsarray[len].attrib\t\n\t\t\t\t\t\t\t}\n\t\tif(mobarrayprio.includes(n) && o==\"m\"){\n                            set_variable(\"tar\",l)\n                            send_command(\"ff\")\n                            }\n        \t\t\t\t\t\n}\n        \n\nif(mobarrayprio.indexOf(n) < 0){\n            //check if should attack or not -normal list\n\t\t\tif(mobarray.includes(y) && z==\"m\"){\n                                    set_variable(\"tar\",x)\n                                    send_command(\"ff\")\n\t\t\t\t\t\t\t\t\t} \n\t\t\t\t\t\t\t\telse {\t\n                                      \tfor(let len=0;(len<client.itemsarray.length)&&(mobarray.indexOf(y) < 0);len++){\n\t\t\t\t\t\t\t\t\t\t\t\t\tx = client.itemsarray[len].id\n                                                    y = client.itemsarray[len].name\n                                                    z = client.itemsarray[len].attrib\n                                                    }\n\t\t\t\t\t\t\t\t\t\tif(mobarray.includes(y) && z==\"m\"){\n                                                        \t\tset_variable(\"tar\",x)\n                                                        \t\tsend_command(\"ff\")\n                                                        \t\t} //close mobarray\n                                        }//close else\n\n            if(mobarray.indexOf(y) < 0){\n                                    nexusclient.add_html_line('<span class=\"xc-CornflowerBlue\"> [No Valid Mobs] </span>');\n                                    send_GMCP('Char.Items.Room')\n                                    }//close mobarray.indexof(y)\n    \n}//mobarrayprioempty"}],"text":"^You have slain a(.+)$","matching":"regexp","whole_words":true,"case_sensitive":true},{"type":"trigger","name":"Kill check bash - Rage","enabled":true,"actions":[{"type":"if","enabled":true,"cond-type1":"variable","cond-val1":"@my_class","cond-type2":"value","cond-val2":"Fury","cond-op":"eq","cond-cs":false,"cond-mod":"is","dothen":"continue","dothenlabel":"","doelse":"stop","doelselabel":""},{"type":"if","enabled":true,"cond-type1":"variable","cond-val1":"@truebash","cond-type2":"value","cond-val2":"1","cond-op":"eq","cond-cs":false,"cond-mod":"","dothen":"continue","dothenlabel":"","doelse":"stop","doelselabel":""},{"type":"if","enabled":true,"cond-type1":"variable","cond-val1":"@st_bladerage","cond-type2":"value","cond-val2":"rage","cond-op":"eq","cond-cs":false,"cond-mod":"","dothen":"continue","dothenlabel":"","doelse":"stop","doelselabel":""},{"type":"script","enabled":true,"script":"send_GMCP('Char.Items.Room')"},{"type":"function","enabled":true,"fn":"onGMCP"},{"type":"script","enabled":true,"script":"//setting up name check array\nlet mobarrayold = [];\nlet a = \"\"\n\na = get_variable(\"mobchecklist\")\nlet c = a.split(\"/\") //changing the string into array\n\nfor (let i=0; i<c.length;i++){\n    c[i]= (c[i])\n}\n\n//Making new array -normal\nlet mobarray = mobarrayold.concat(c);\n\n//Making new array - prop\na = get_va