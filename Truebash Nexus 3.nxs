sh(y)\n\n  let roomnumindex = maparray.indexOf(roomnumber)\n  let prevvalue = roomnumindex - 1\n  if (maparray[prevvalue] != (\"e\"||\"n\"||\"s\"||\"w\"||\"ne\"||\"sw\"||\"se\"||\"ne\"||\"in\"||\"out\"||\"u\"||\"d\"||\"rep\"||\"-\")) {\n      maparray.splice(roomnumindex,0,get_variable(\"prevmove\"))\n  }\nlet x = maparray.join(\"/\")\n    set_variable(\"tbroomtrack\",x);\n\tdisplay_notice(\"Roomtrack List: \"+ x);\n} else{ \n    if(get_variable(\"tbmapping\") == \"1\" && tbmaparea == currentarea && maparray.includes(roomnumber)){\n      let pushval = \"rep \"\n      pushval += roomnumber\n      maparray.push(pushval)\n\n      let x = maparray.join(\"/\")\n    set_variable(\"tbroomtrack\",x);\n\tdisplay_notice(\"Roomtrack List: \"+ x);\n      }\n    }"}],"text":"^mapherenow$","matching":"regexp","whole_words":true,"case_sensitive":true},{"type":"alias","name":"","enabled":true,"actions":[{"type":"script","enabled":true,"script":"  display_notice(client.areaname)"}],"text":"areainfo","matching":"exact","whole_words":true,"case_sensitive":true,"prefix_suffix":true},{"type":"alias","name":"Map Area","enabled":true,"actions":[{"type":"script","enabled":true,"script":"set_variable(\"tbmaparea\",client.areaname)\ndisplay_notice(\"Mapping Area: \"+get_variable(\"tbmaparea\"))"}],"text":"maparea","matching":"exact","whole_words":true,"case_sensitive":true,"prefix_suffix":true},{"type":"trigger","name":"Mapping Movements","enabled":true,"actions":[{"type":"if","enabled":true,"cond-type1":"variable","cond-val1":"tbmapping","cond-type2":"value","cond-val2":"1","cond-op":"eq","cond-cs":false,"cond-mod":"is","dothen":"continue","dothenlabel":"","doelse":"stop","doelselabel":""},{"type":"script","enabled":true,"script":"let dir = args[1]\nlet movement = \"\"\nif (dir == \"above\") {movement = \"u\"}\nif (dir == \"below\") {movement = \"d\"}\n\nset_variable(\"prevmove\",movement)"},{"type":"wait","enabled":true,"seconds":0,"milliseconds":50},{"type":"command","enabled":true,"comma