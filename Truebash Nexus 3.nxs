"whole_words":false,"case_sensitive":false}]},{"type":"trigger","name":"Blade capture","enabled":true,"actions":[{"type":"script","enabled":true,"script":"set_variable(\"st_bladerage\",\"rage\")\n\nlet atk = \"\"\natk = args[1]\n\nlet nextstance = {\n    'Gutrend'\t\t:\t'Flare',\n    'Sear'\t\t\t:\t'Symmetry',\n    'Swiftcut'\t\t:\t'Ember',\n    'Legspike'\t\t:\t'Symmetry',\n    'Sweep'\t\t\t:\t'Spark',\n    'Assail'\t\t:\t'Blaze',\n    'Bombard'\t\t:\t'Ember',\n    'Cripple'\t\t:\t'Ember',\n    'Barrage'\t\t:\t'Ember',\n    'Raindown'\t\t:\t'Ember',\n    'Heartrend'\t\t:\t'Ember',\n    'Hew'\t\t\t:\t'Ember',\n    'Salvo'\t\t\t:\t'Ember',\n    'Sting'\t\t\t:\t'Ember',\n    'Blitz'\t\t\t:\t'Ember',\n    'Flamebound'\t:\t'Ember',\n    'Asymmetry'\t\t:\t'Flare',\n    'Rupture'\t\t:\t'Flare',\n    'Hypertension'\t:\t'Flare',\n    'Bloodsinge'\t:\t'Flare',\n    'Bloodburn'\t\t:\t'Flare',\n    'Concuss'\t\t:\t'Flare',\n    'Pummel'\t\t:\t'Flare',\n    'Cleave'\t\t:\t'Flare',\n    'Rend'\t\t\t:\t'Flare',\n    'Sunder'\t\t:\t'Flare',\n    'Wound'\t\t\t:\t'Eruption',\n    'Drive'\t\t\t:\t'Inferno'\n}\n\nset_variable(\"st_next\",nextstance[atk])"}],"text":"^You\\: Blade (\\w+)\\s(.+)$","matching":"regexp","whole_words":true,"case_sensitive":true},{"type":"trigger","name":"Rage capture","enabled":true,"actions":[{"type":"script","enabled":true,"script":"set_variable(\"st_bladerage\",\"blade\")"}],"text":"^You(.+)Rage(.+)$","matching":"regexp","whole_words":true,"case_sensitive":true},{"type":"trigger","name":"Rage capture - too late to rage","enabled":true,"actions":[{"type":"script","enabled":true,"script":"set_variable(\"st_bladerage\",\"blade\")"}],"text":"^The opportunity for using a rage attack has passed.$","matching":"regexp","whole_words":true,"case_sensitive":true},{"type":"alias","name":"Fury Def Up","enabled":true,"actions":[{"type":"script","enabled":true,"script":"let flrank = Number(get_variable(\"FulminationRank\"))\nlet bfrank = Number(get_variable(\"BattleflowRank\"))\nlet rgrank = Number(get_variable(\"RageRank\"))\n\n\n\nif (get_variable(\"defup\") == \"1\") {\n  if (get_variable(\"wwprio\") != \"health\") {send_command(\"wwh\")} else\n  if (flrank > 10 && get_variable(\"def_balancing\") == \"0\") {send_command(\"kith balancing\")} else\n  if (flrank > 9 && get_variable(\"def_warmth\") == \"0\" && get_variable(\"warmth_can\") ==\"1\") {send_command(\"kith warmth\")} else\n  if (flrank > 12 && get_variable(\"def_firewreathe\") == \"0\") {send_command(\"kith firewreathe\")} else\n  if (flrank > 7 && get_variable(\"def_harden\") == \"0\") {send_command(\"kith harden\")} else\n  {set_variable(\"defup\",\"0\")\n   display_notice(\"***DEFS UP***\",\"Yellow\")}\n}"}],"text":"furydefup","matching":"exact","whole_words":true,"case_sensitive":true,"prefix_suffix":true},{"type":"trigger","name":"Balancing get","enabled":true,"actions":[{"type":"script","enabled":true,"script":"set_variable(\"def_balancing\",\"1\")"}],"text":"^You focus on your kith to prevent falling.$","matching":"regexp","whole_words":true,"case_sensitive":true},{"type":"trigger","name":"Balancing alr got","enabled":true,"actions":[{"type":"script","enabled":true,"script":"set_variable(\"def_balancing\",\"1\")\nif(get_variable(\"defup\")==\"1\"){send_command(\"defup\")}"}],"text":"^You're already balancing.$","matching":"regexp","whole_words":true,"case_sensitive":true},{"type":"trigger","name":"Warmth Get","enabled":true,"actions":[{"type":"script","enabled":true,"script":"set_variable(\"def_warmth\",\"1\")"}],"text":"^You focus on warming up your skin with kith energy.$","matching":"regexp","whole_words":true,"case_sensitive":true},{"type":"trigger","name":"Warmth Cannot Yet","enabled":true,"actions":[{"type":"script","enabled":true,"script":"if(get_variable(\"my_class\") == \"Fury\") {set_variable(\"warmth_can\",\"0\")}"}],"text":"^You cannot do that again so soon.$","matching":"regexp","whole_words":true,"case_sensitive":true},{"type":"trigger","name":"Warmth Alr Got ","enabled":true,"actions":[{"type":"script","enabled":true,"script":"set_variable(\"def_warmth\",\"1\")\nif(get_variable(\"defup\")==\"1\"){send_command(\"defup\")}"}],"text":"^You're already protected from being frozen.$","matching":"regexp","whole_words":true,"case_sensitive":true},{"type":"trigger","name":"FireWreathe Alr Got ","enabled":true,"actions":[{"type":"script","enabled":true,"script":"set_variable(\"def_firewreathe\",\"1\")\nif(get_variable(\"defup\")==\"1\"){send_command(\"defup\")}"}],"text":"^You are already wreathed in fire.$","matching":"regexp","whole_words":true,"case_sensitive":true},{"type":"trigger","name":"FireWreathe Got ","enabled":true,"actions":[{"type":"script","enabled":true,"script":"set_variable(\"def_firewreathe\",\"1\")"}],"text":"^You form a wreathe of kith-induced fire around yourself.$","matching":"regexp","whole_words":true,"case_sensitive":true},{"type":"trigger","name":"Harden Got ","enabled":true,"actions":[{"type":"script","enabled":true,"script":"set_variable(\"def_harden\",\"1\")"}],"text":"^You focus on hardening your skin with kith energy.$","matching":"regexp","whole_words":true,"case_sensitive":true},{"type":"trigger","name":"Harden Alr Got ","enabled":true,"actions":[{"type":"script","enabled":true,"script":"set_variable(\"def_harden\",\"1\")\nif(get_variable(\"defup\")==\"1\"){send_command(\"defup\")}"}],"text":"^Your muscles are already hardened.$","matching":"regexp","whole_words":true,"case_sensitive":true}]}]}]},{"type":"trigger","name":"Kill check bash - debugging","enabled":false,"actions":[{"type":"if","enabled":true,"cond-type1":"variable","cond-val1":"@truebash","cond-type2":"value","cond-val2":"1","cond-op":"eq","cond-cs":false,"cond-mod":"","dothen":"continue","dothenlabel":"","doelse":"stop","doelselabel":""},{"type":"script","enabled":true,"script":"send_GMCP('Char.Items.Room')"},{"type":"waitfor","enabled":true,"text":"^You have recovered your balance.$","matching":"regexp","whole_words":false,"case_sensitive":false,"expire":"5"},{"type":"script","enabled":true,"script":"//setting up name check array\nlet mobarrayold = [];\nlet a = \"\"\n\na = client.get_variable(\"mobchecklist\")\nlet c = a.split(\",\") //changing the string into array\n\nfor (let i=0; i<c.length;i++){\n    c[i]= (c[i])\n}\n\n//Making new array -normal\nlet mobarray = mobarrayold.concat(c);\n\n//Making new array - prop\na = client.get_variable(\"mobpriochecklist\")\nlet b = a.split(\",\") //changing the string into array\n\nfor (var i=0; i<b.length;i++){\n    b[i]= (b[i])\n}\n\n\nlet mobarrayprio = mobarrayold.concat(b);\n\n\n//check if should attack or not -PRIO first\n\nlet t, l, n, o = \"\";\nt = client.prioitemsarray.length-1\nif (t>-1){\t\n    l = client.prioitemsarray[t].id\n    n = client.prioitemsarray[t].name\n    o = client.prioitemsarray[t].attrib\n}\n\n//setting up the target\nlet g, x, y, z = \"\";\ng = client.itemsarray.length-1\nif (g>-1){\n\tx = client.itemsarray[g].id\n    y = client.itemsarray[g].name\n    z = client.itemsarray[g].attrib\n}\n\ndisplay_notice(\"Normal array:\" + g + \" \" + x + \" \" + y + \" \" + z)\ndisplay_notice(\"Prio array:\" + t + \" \" + l + \" \" + n + \" \" + o)\n\n\nif(mobarrayprio.includes(n) && o==\"m\"){\n\t\t\t\t\t\tclient.set_variable(\"tar\",l)\n                        send_command(\"ff\")\n                        client.set_variable(\"lastkill\",\"prio\")\n\t\t\t\t\t\t} \nelse {\t\n\t\tfor(let len=0;(len<client.prioitemsarray.length)&&(mobarray.indexOf(n) < 0);len++){\n\t\t\t\t\t\t\tl = client.prioitemsarray[len].id\n\t\t\t\t\t\t\tn = client.prioitemsarray[len].name\n\t\t\t\t\t\t\to = client.prioitemsarray[len].attrib\n        \t\t\t\t\tdisplay_notice(\"Prio array:\" + \" \" + l + \" \" + n + \" \" + o +  \"while loop\")\t\n\t\t\t\t\t\t\t}\n\t\tif(mobarrayprio.includes(n) && o==\"m\"){\n                            client.set_variable(\"tar\",l)\n                            send_command(\"ff\")\n                            client.set_variable(\"lastkill\",\"prio\")\n                            }\n        \t\t\t\t\t\n}\n        \n\n\ndisplay_notice(\"Normal array:\" + g + \" \" + x + \" \" + y + \" \" + z + \"After Prio\")\ndisplay_notice(\"Prio array:\" + t + \" \" + l + \" \" + n + \" \" + o +  \"After Prio\")\n\nif(mobarrayprio.indexOf(n) < 0){\n    \t\tdisplay_notice(\"No Attackable Priority Mobs\",\"#ff8080\");\n            //check if should attack or not -normal list\n\t\t\tif(mobarray.includes(y) && z==\"m\"){\n                                    client.set_variable(\"tar\",x)\n                                    send_command(\"ff\")\n                                    client.set_variable(\"lastkill\",\"normal\")\n\t\t\t\t\t\t\t\t\t} \n\t\t\t\t\t\t\t\telse {\t\n                                      \tfor(let len=0;(len<client.itemsarray.length)&&(mobarray.indexOf(y) < 0);len++){\n\t\t\t\t\t\t\t\t\t\t\t\t\tx = client.itemsarray[len].id\n                                                    y = client.itemsarray[len].name\n                                                    z = client.itemsarray[len].attrib\n                                                \tdisplay_notice(\"Normal array:\" + \" \" + x + \" \" + y + \" \" + z + \"while loop\")\n                                                    }\n\t\t\t\t\t\t\t\t\t\tif(mobarray.includes(y) && z==\"m\"){\n                                                        \t\tclient.set_variable(\"tar\",x)\n                                                        \t\tsend_command(\"ff\")\n                                                        \t\tclient.set_variable(\"lastkill\",\"normal\")\n                                                        \t\t} //close mobarray\n                                        }//close else\n\n            if(mobarray.indexOf(y) < 0){\n                                    display_notice(\"No Attackable Mobs\",\"#ffbf80\");\n                                    send_GMCP('Char.Items.Room')\n                                    }//close mobarray.indexof(y)\n    \n}//mobarrayprioempty\n\n\ndisplay_notice(\"Normal array:\" + g + \" \" + x + \" \" + y + \" \" + z + \"After Normal\")\ndisplay_notice(\"Prio array:\" + t + \" \" + l + \" \" + n + \" \" + o +  \"After Normal\")"}],"text":"^You have slain a(.+)$","matching":"regexp","whole_words":true,"case_sensitive":true},{"type":"group","name":"Auto Target Add","enabled":true,"items":[{"type":"alias","name":"Autotarget add toggle","enabled":true,"actions":[{"type":"script","enabled":true,"script":"let autotarget = get_variable(\"autotargetadd\")\n\nif (autotarget == \"0\") {\n  set_variable(\"autotargetadd\",\"1\")\n  display_notice(\"***Auto Target Adding Now On!!***\",\"green\")\n} else {\n  if (autotarget == \"1\") {\n  set_variable(\"autotargetadd\",\"0\")\n  display_notice(\"***Auto Target Adding Now Off!!***\",\"red\")\n  }\n}"}],"text":"autoadd","matching":"exact","whole_words":true,"case_sensitive":true,"prefix_suffix":true}]},{"type":"alias","name":"Read Me","enabled":true,"actions":[{"type":"script","enabled":true,"script":"display_notice(\"**TRUEBASH README - USE 'tb' TO TURN ON AND OFF!\",\"#00cc66\",\"#000000\")\ndisplay_notice(\"There are two mob-checklists that are used in this system - a Priority Checklist for priority targets, and a Normal Checklist for lower priority targets.\",\"#ffb366\",\"#000000\")\ndisplay_notice(\"To add to the Priority List, use 'mobprioadd <insert full mobname here>' (e.g. mobprioadd a sparkling eel)\",\"#ffb366\",\"#000000\")\ndisplay_notice(\"To add to the Normal List, use 'mobadd <insert full mobname here>'  (e.g. mobadd a sparkling eel)\",\"#ffb366\",\"#000000\")\ndisplay_notice(\"To view mobs on both lists, simply use 'moblist'\",\"#ffb366\",\"#000000\")\ndisplay_notice(\"To remove mobs from either list, use 'mobremove' or 'mobprioremove'\",\"#ffb366\",\"#000000\")\ndisplay_notice(\"**Warning: This system ONLY TARGETS MOBS (not players) and does not check for targets entering or leaving a room, nor does it check for aggressive mobs engaging you before starting to engage any valid targets!!\",\"#ff5050\")\n\ndisplay_notice(\"To target something, use 'x <something>' to change your target to <something>\",\"#ffb366\",\"#000000\")\ndisplay_notice(\"To attack, the default alias is 'ff'\",\"#ffb366\",\"#000000\")\ndisplay_notice(\"To stop attacking, the default alias is 'ahoff'\",\"#ffb366\",\"#000000\")\ndisplay_notice(\"***Auto Target Adding Function: auto adds new mobs killed into Prio Mob List. Type 'autoadd' to turn on or off!***\",\"red\")\ndisplay_notice(\"***Certain areas are mapped. Type 'walktest' to manually move rooms in those areas.***\",\"yellow\")\n\ndisplay_notice(\"**Warning: This system is fresh for Nexus 3 and can be buggy/overly basic! Please let me (Xuthori) know if you have any comments/suggestions/bugs to report!\",\"#ff5050\")\n\ndisplay_notice(\"**Warning: Please familiarize yourself with HELP AUTOMATION to use this properly!!\",\"#ff5050\")"}],"text":"readme","matching":"exact","whole_words":true,"case_sensitive":true,"prefix_suffix":true}]},{"type":"group","name":"heals","enabled":true,"items":[{"type":"alias","name":"cosmpiercer heal","enabled":true,"actions":[{"type":"command","enabled":true,"command":"cosmpiercer heal","prefix_suffix":true}],"text":"ch","matching":"exact","whole_words":false,"case_sensitive":false,"prefix_suffix":true},{"type":"alias","name":"ww priorities health afflictions systems","enabled":true,"actions":[{"type":"command","enabled":true,"command":"ww priorities health afflictions systems","prefix_suffix":true},{"type":"variable","enabled":true,"varname":"@wwprio","valtype":"value","value":"health","op":"set"}],"text":"wwh","matching":"begins","whole_words":true,"case_sensitive":false,"prefix_suffix":true},{"type":"alias","name":"ww priorities afflictions health systems","enabled":true,"actions":[{"type":"command","enabled":true,"command":"ww priorities afflictions health systems","prefix_suffix":true},{"type":"v