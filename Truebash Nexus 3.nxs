{"type":"function","enabled":true,"fn":"onGMCP"},{"type":"script","enabled":true,"script":"//First three skills are always Class Skills, so want to get their ranks\nlet f,g,h,i= \"\"\nf = client.skillsarray.length-1\nif (f>-1){\t\n    g = client.skillsarray[0]\n    h = client.skillsarray[1]\n    i = client.skillsarray[2]\n}\n\n//Grabbing numerical rank of the skills\nlet skillset1name,skillset1rank,skillset2name,skillset2rank,skillset3name,skillset3rank = \"\"\nskillset1name = g.name\nskillset1rank = parseInt(g.rank.slice(1).slice(0,-3), 10) //parseInt = converts string into integer; slice(1) removes first character from a string, and slice (0, -3) removes the last 3 characters => this works because the raw output was \" 7/30\"\nskillset2name = h.name\nskillset2rank = parseInt(h.rank.slice(1).slice(0,-3), 10)\nskillset3name = i.name\nskillset3rank = parseInt(i.rank.slice(1).slice(0,-3), 10)\n\n//Checking output\ndisplay_notice(skillset1name+\",\"+skillset1rank+\",\"+skillset2name+\",\"+skillset2rank+\",\"+skillset3name+\",\"+skillset3rank)\n\nlet skillset1,skillset2,skillset3 = \"\"\nskillset1 = skillset1name + \"Rank\"\nskillset2 = skillset2name + \"Rank\"\nskillset3 = skillset3name + \"Rank\"\n\nset_variable(skillset1,skillset1rank)\nset_variable(skillset2,skillset2rank)\nset_variable(skillset3,skillset3rank)"}],"text":"getskills","matching":"exact","whole_words":true,"case_sensitive":true,"prefix_suffix":true},{"type":"trigger","name":"Login Get Skills","enabled":true,"actions":[{"type":"command","enabled":true,"command":"getskills","prefix_suffix":false}],"text":"^You blink hazily as your eyes adjust to the world around you and you quickly consult your mindsim to catch up on worldly affairs.$","matching":"regexp","whole_words":true,"case_sensitive":true},{"type":"trigger","name":"Learn Stuff Get Skills","enabled":true,"actions":[{"type":"command","enabled":true,"command":"getskills","prefix_suffix":false}],"text":"^As the lesson ends, you ponder your new-found knowledge.$","matching":"regexp","whole_words":true,"case_sensitive":true},{"type":"alias","name":"Def Up","enabled":true,"actions":[{"type":"script","enabled":true,"script":"set_variable(\"defup\",\"1\")\n\nlet classdef = \"\"\nlet currclass = \"\"\ncurrclass = get_variable(\"Truebashclass\")\n\nswitch (currclass) {\n case \"Nanoseer\":\n\tclassdef = \"nanodefup\";\n\tbreak;\n case \"Fury\":\n\tclassdef = \"furydefup\";\n\tbreak;\n case \"Scoundrel\":\n\tclassdef = \"scoundefup\";\n\tbreak;\n case \"Engineer\":\n\tclassdef = \"engdefup\";\n\tbreak;\n case \"B.E.A.S.T.\":\n\tclassdef = \"beastdefup\";\n\tbreak; \n}\n\nsend_command(classdef)"}],"text":"defup","matching":"exact","whole_words":true,"case_sensitive":true,"prefix_suffix":true},{"type":"alias","name":"Def Reset ","enabled":true,"actions":[{"type":"script","enabled":true,"script":"//General\nset_variable(\"selfheal\",\"1\");\nset_variable(\"autobash\",\"0\");\nset_variable(\"truebash\",\"0\");\nset_variable(\"defup\",\"0\");\nset_variable(\"prev_atk\",\"0\");\n\n//Nano\nset_variable(\"frenzy_avail\",\"1\");\nset_variable(\"frenzy_got\",\"0\");\nset_variable(\"speedup_avail\",\"1\");\nset_variable(\"speedup_got\",\"0\");\nset_variable(\"pointzero_got\",\"0\");\nset_variable(\"multistrike_avail\",\"1\");\nset_variable(\"channel_progenitor\",\"0\");\nset_variable(\"affinity_conqueror\",\"0\");\nset_variable(\"affinity_traveller\",\"0\");\nset_variable(\"channel_conqueror\",\"0\");\nset_variable(\"channel_traveller\",\"0\");\n\n//Fury\nset_variable(\"st_bladerage\",\"blade\");\nset_variable(\"st_next\",\"0\");\nset_variable(\"aff_hypertension\",\"0\");\nset_variable(\"unstop_can\",\"0\");\nset_variable(\"st_unstoppable\",\"0\");\nset_variable(\"st_berserk\",\"0\");\nset_variable(\"def_harden\",\"0\");\nset_variable(\"def_firewreathe\",\"0\");\nset_variable(\"def_balancing\",\"0\");\nset_variable(\"def_warmth\",\"0\");\nset_variable(\"warmth_can\",\"1\");\nset_variable(\"bladeshape\",\"wind\");\n\n//Scoundrel\nset_variable(\"ambush_avail\",\"1\");\nset_variable(\"rapidfire_avail\",\"1\");\nset_variable(\"bullet_ammo\",\"regular\");\n\n//Engineer\nset_variable(\"got_carrybot\",\"0\");\nset_variable(\"got_taser\",\"0\");\n\n//Beast\nset_variable(\"dualshot_avail\",\"1\");\nset_variable(\"nozzle_state\",\"0\");\nset_variable(\"beast_resistance\",\"0\");\nset_variable(\"plasma_overload\",\"0\");\nset_variable(\"plasma_heatup\",\"0\");\nset_variable(\"rails_avail\",\"1\");\n\n\n"},{"type":"notify","enabled":true,"notice":"***DEFS RESET***","notice_fg":"#00fffa","notice_bg":"#000000"}],"text":"defreset","matching":"exact","whole_words":true,"case_sensitive":true,"prefix_suffix":true},{"type":"trigger","name":"Balance Defs","enabled":true,"actions":[{"type":"script","enabled":true,"script":"if(get_variable(\"defup\") == \"1\") {\n  \nlet classdef = \"\"\nlet currclass = \"\"\ncurrclass = get_variable(\"Truebashclass\")\n\nswitch (currclass) {\n case \"Nanoseer\":\n\tclassdef = \"nanodefup\";\n\tbreak;\n case \"Fury\":\n\tclassdef = \"furydefup\";\n\tbreak;\n case \"Scoundrel\":\n\tclassdef = \"scoundefup\";\n\tbreak;\n case \"Engineer\":\n\tclassdef = \"engdefup\";\n\tbreak;\n case \"B.E.A.S.T.\":\n\tclassdef = \"beastdefup\";\n\tbreak; \n}\n\nsend_command(classdef)\n  \n}"}],"text":"^You have recovered your balance.$","matching":"regexp","whole_words":true,"case_sensitive":true},{"type":"group","name":"Heals","enabled":true,"items":[{"type":"trigger","name":"Heal Avail","enabled":true,"actions":[{"type":"gag","enabled":true},{"type":"notify","enabled":true,"notice":"***HEAL AVAIL***","notice_fg":"#ff0000","notice_bg":"#2efff9"},{"type":"variable","enabled":true,"varname":"@selfheal","valtype":"value","value":"1","op":"set"}],"text":"^(It is safe to suffuse yourself.+|Your HUD indicates that you may.+|Your nanites can again repair your body.|You can once again embrace.+|You can again use a stimjector.|You can again use a stim.)$","matching":"regexp","whole_words":false,"case_sensitive":false},{"type":"trigger","name":"Heal wasted (Full Health)","enabled":true,"actions":[{"type":"gag","enabled":true},{"type":"notify","enabled":true,"notice":"***FULLHEALTH ALR***","notice_fg":"#000000","notice_bg":"#f0ff00"},{"type":"variable","enabled":true,"varname":"@selfheal","valtype":"value","value":"0","op":"set"}],"text":"^(You activate your emergency.+|You inhale a cloud of your swarm, but.+|You draw upon the very power that surrounds you and fi.+|You activate your stimjector, but.+|Using stims while in perfe.+|Trying to pour more kith energy.+)$","matching":"regexp","whole_words":false,"case_sensitive":false},{"type":"trigger","name":"heal done verbose","enabled":true,"actions":[{"type":"gag","enabled":true},{"type":"notify","enabled":true,"notice":"***HEALING***","notice_fg":"#fecdf4","notice_bg":"#000000"},{"type":"variable","enabled":true,"varname":"@selfheal","valtype":"value","value":"0","op":"set"}],"text":"^(You activate your suit's emergency.+|Drawing a deep breath, you embrace the darkness at the .+|You inhale a cloud of your swarm, and you.+|You activate your stimjector, feel.+|You jam a stim into your vein.+|The heart of distant stars and the fire at.+)$","matching":"regexp","whole_words":false,"case_sensitive":false},{"type":"trigger","name":"heal done","enabled":true,"actions":[{"type":"gag","enabled":true},{"type":"notify","enabled":true,"notice":"***HEALING***","notice_fg":"#fecdf4","notice_bg":"#000000"},{"type":"variable","enabled":true,"varname":"@selfheal","valtype":"value","value":"0","op":"set"}],"text":"^You.+(Kith Suffuse|Voidism Embrace|Guile Stim|Suit Support|Gadget Stimjector)\\.$","matching":"regexp","whole_words":false,"case_sensitive":false},{"type":"alias","name":"Heal Alias","enabled":true,"actions":[{"type":"script","enabled":true,"script":"let classheal = \"\"\nlet currclass = \"\"\ncurrclass = get_variable(\"Truebashclass\")\n\nswitch (currclass) {\n case \"Nanoseer\":\n\tclassheal = \"void embrace\";\n\tbreak;\n case \"Fury\":\n\tclassheal = \"kith suffuse\";\n\tbreak;\n case \"Scoundrel\":\n\tclassheal = \"guile stim\";\n\tbreak;\n case \"Engineer\":\n\tif (!GMCP.Defences[\"Stimjector\"]) {classheal = \"operate stimjector \" + get_variable(\"myname\")} else {classheal = \"engpveatk\"};\n\tbreak;\n case \"B.E.A.S.T.\":\n\tclassheal = \"suit support\";\n\tbreak; \n}\n\nsend_command(classheal)"}],"text":"dr","matching":"begins","whole_words":true,"case_sensitive":false,"prefix_suffix":true}]},{"type":"group","name":"Defences and Skill Triggers","enabled":true,"items":[{"type":"group","name":"Nanoseer Triggers","enabled":true,"items":[{"type":"trigger","name":"Frenzy Used","enabled":true,"actions":[{"type":"script","enabled":true,"script":"set_variable(\"frenzy_avail\",\"0\")\nset_variable(\"frenzy_got\",\"1\")\nif(get_variable(\"autobash\")==\"1\") {send_command(\"nanopveatk\")}"}],"text":"^You/+Oblivion Frenzy.$","matching":"regexp","whole_words":true,"case_sensitive":true},{"type":"trigger","name":"Frenzy Got Verbose","enabled":true,"actions":[{"type":"script","enabled":true,"script":"set_variable(\"frenzy_avail\",\"0\")\nset_variable(\"frenzy_got\",\"1\")\nif(get_variable(\"autobash\")==\"1\") {send_command(\"nanopveatk\")}"}],"text":"^A dark wave of madness rolls through your thoughts, and an impossibly vast mind seems to descend over your own, the Conquerer arriving to drive you into a dangerous frenzy.$","matching":"regexp","whole_words":true,"case_sensitive":true},{"type":"trigger","name":"Frenzy removed","enabled":true,"actions":[{"type":"script","enabled":true,"script":"set_variable(\"frenzy_got\",\"0\")"}],"text":"^You break out of your frenzy.$","matching":"regexp","whole_words":true,"case_sensitive":true},{"type":"trigger","name":"Frenzy Alr got","enabled":true,"actions":[{"type":"script","enabled":true,"script":"set_variable(\"frenzy_got\",\"1\")\nif (get_variable(\"autobash\") == \"1\") {send_command(\"ff\")}"}],"text":"^You have already descended into a frenzy.+to draw more of the Conquerer into your thoughts would utterly destroy your mind.$","matching":"regexp","whole_words":true,"case_sensitive":true},{"type":"trigger","name":"Frenzy Can","enabled":true,"actions":[{"type":"script","enabled":true,"script":"set_variable(\"frenzy_avail\",\"1\")"}],"text":"^You can again whip yourself into a frenzy.$","matching":"regexp","whole_words":true,"case_sensitive":true},{"type":"trigger","name":"Speedup Used","enabled":true,"actions":[{"type":"script","enabled":true,"script":"set_variable(\"speedup_avail\",\"0\")\nset_variable(\"speedup_got\",\"1\")"}],"text":"^You.+Oblivion Speedup.$","matching":"regexp","whole_words":true,"case_sensitive":true},{"type":"trigger","name":"Speedup Got Verbose","enabled":true,"actions":[{"type":"script","enabled":true,"script":"set_variable(\"speedup_avail\",\"0\")\nset_variable(\"speedup_got\",\"1\")"}],"text":"^You snap your fingers, and time starts flowing faster around you as the power of the Traveller overtakes the location.$","matching":"regexp","whole_words":true,"case_sensitive":true},{"type":"trigger","name":"Speedup Removed","enabled":true,"actions":[{"type":"script","enabled":true,"script":"set_variable(\"speedup_got\",\"0\")"}],"text":"^The time distortion effect ends.$","matching":"regexp","whole_words":true,"case_sensitive":true},{"type":"trigger","name":"Speedup Alr Got","enabled":true,"actions":[{"type":"script","enabled":true,"script":"set_variable(\"speedup_got\",\"1\")\nif (get_variable(\"autobash\") == \"1\") {send_command(\"ff\")}"}],"text":"^Time has already been distorted at this location.$","matching":"regexp","whole_words":true,"case_sensitive":true},{"type":"trigger","name":"Speedup Can","enabled":true,"actions":[{"type":"script","enabled":true,"script":"set_variable(\"speedup_avail\",\"1\")"}],"text":"^You can again speed up the passage of time.$","matching":"regexp","whole_words":true,"case_sensitive":true},{"type":"trigger","name":"Channel Progenitor","enabled":true,"actions":[{"type":"script","enabled":true,"script":"set_variable(\"channel_progenitor\",\"1\");\nset_variable(\"channel_traveller\",\"0\");\nset_variable(\"channel_conqueror\",\"0\");\n"}],"text":"^You reach into your connection to the void, stretching through it to touch the darkness at the end of the galaxy and the beginning of time, where the Progenitor and its raw power wait for your hand to wield it.$","matching":"regexp","whole_words":true,"case_sensitive":true},{"type":"trigger","name":"Channel End","enabled":true,"actions":[{"type":"script","enabled":true,"script":"set_variable(\"channel_progenitor\",\"0\");\nset_variable(\"channel_traveller\",\"0\");\nset_variable(\"channel_conqueror\",\"0\");\n"}],"text":"^You.+Oblivion Channel End.$","matching":"regexp","whole_words":true,"case_sensitive":true},{"type":"trigger","name":"Affinity Got","enabled":true,"actions":[{"type":"script","enabled":true,"script":"let affinity = \"\"\naffinity = args[1]\n\nswitch (affinity) {\n case \"Conqueror\":\n\tset_variable(\"affinity_conqueror\",\"1\");\n\tbreak;\n case \"Traveller\":\n\tset_variable(\"affinity_traveller\",\"1\");\n\tbreak;\n case \"Progenitor\":\n\tset_variable(\"affinity_progenitor\",\"1\");\n\tbreak;\n case \"Sunderer\":\n\tset_variable(\"affinity_sunderer\",\"1\");\n\tbreak;\n case \"Architect\":\n\tset_variable(\"affinity_architect\",\"1\");\n\tbreak; \n}\n"}],"text":"^You plunge yourself deeper into oblivion, enhancing your affinity towards the (\\w+)\\.$","matching":"regexp","whole_words":true,"case_sensitive":true},{"type":"trigger","name":"Affinity Alr Got","enabled":true,"actions":[{"type":"script","enabled":true,"script":"let affinity = \"\"\naffinity = args[1]\n\nswitch (affinity) {\n case \"Conqueror\":\n\tset_variable(\"affinity_conqueror\",\"1\");\n\tbreak;\n case \"Traveller\":\n\tset_variable(\"affinity_traveller\",\"1\");\n\tbreak;\n case \"Progenitor\":\n\tset_variable(\"affinity_progenitor\",\"1\");\n\tbreak;\n case \"Sunderer\":\n\tset_variable(\"affinity_sunderer\",\"1\");\n\tbreak;\n case \"Architect\":\n\tset_variable(\"affinity_architect\",\"1\");\n\tbreak; \n}\n"}],"text":"^You have already formed affinity with the (\\w+)\\.$","matching":"regexp","whole_words":true,"case_sensitive":true},{"type":"trigger","name":"Affinity Removed","enabled":true,"actions":[{"type":"script","enabled":true,"script":"let affinity = \"\"\naffinity = args[1]\n\nswitch (affinity) {\n case \"Conqueror\":\n\tset_variable(\"affinity_conqueror\",\"0\");\n\tbreak;\n case \"Traveller\":\n\tset_variable(\"affinity_traveller\",\"0\");\n\tbreak;\n case \"Progenitor\":\n\tset_variable(\"affinity_progenitor\",\"0\");\n\tbreak;\n case \"Sunderer\":\n\tset_variable(\"affinity_sunderer\",\"0\");\n\tbreak;\n case \"Architect\":\n\tset_variable(\"affinity_architect\",\"0\");\n\tbreak; \n}\n"}],"text":"^With a substantial effort, you draw yourself free from the affinity towards the (\\w+)\\.$","matching":"regexp","whole_words":true,"case_sensitive":true},{"type":"trigger","name":"PointZero Got","enabled":true,"actions":[{"type":"script","enabled":true,"script":"set_variable(\"pointzero_got\",\"1\");"}],"text":"^You.+Void Point Zero.$","matching":"regexp","whole_words":true,"case_sensitive":true},{"type":"trigger","name":"PointZero Got Verbose","enabled":true,"actions":[{"type":"script","enabled":true,"script":"set_variable(\"pointzero_got\",\"1\");"}],"text":"^The air crackles and contracts, fogged condensation drifting around you.+$","matching":"regexp","whole_words":true,"case_sensitive":true},{"type":"trigger","name":"PointZero Alr Got","enabled":true,"actions":[{"type":"script","enabled":true,"script":"set_variable(\"pointzero_got\",\"1\");\nif(get_variable(\"autobash\") ==\"1\") {send_command(\"nanopveatk\")}"}],"text":"^Lifting your hand, you call upon the void within, seeking to form a sphere of absolute zero temperature, but realize there is one here already.$","matching":"regexp","whole_words":true,"case_sensitive":true},{"type":"trigger","name":"PointZero Alr in Room","enabled":true,"actions":[{"type":"script","enabled":true,"script":"set_variable(\"pointzero_got\",\"1\");"}],"text":"^Air swirls around a point of absolute coldness here.$","matching":"regexp","whole_words":true,"case_sensitive":true},{"type":"trigger","name":"PointZero Gone","enabled":true,"actions":[{"type":"script","enabled":true,"script":"set_variable(\"pointzero_got\",\"0\");"}],"text":"^The swirling point zero suddenly collapses into itself.$","matching":"regexp","whole_words":true,"case_sensitive":true}]},{"type":"group","name":"BEAST Triggers","enabled":true,"items":[{"type":"alias","name":"Beast Def Up","enabled":true,"actions":[{"type":"script","enabled":true,"script":"let mypl = Number(get_variable(\"my_pl\"))\n\nlet pcrank = Number(get_variable(\"PlasmaCastingRank\"))\nlet mwprank = Number(get_variable(\"MWPRank\"))\nlet strank = Number(get_variable(\"SuitTechRank\"))\n\nif(get_variable(\"defup\") == \"1\") {\n if(get_variable(\"wwprio\") != \"health\") {send_command(\"wwh\")} else\n if(pcrank > 10 && get_variable(\"nozzle_state\") != \"wide\") {send_command(\"plasma nozzle wide\")} else\n if(pcrank > 2 && get_variable(\"beast_resistance\") == \"0\" && mypl > 9) {send_command(\"plasma resistance\")}else\n   if(pcrank > 0 && get_variable(\"plasma_heatup\") == \"0\") {send_command(\"plasma heatup\")} else\n     if(get_variable(\"nozzle_state\") == \"wide\" && get_variable(\"plasma_heatup\") == \"1\" && get_variable(\"beast_resistance\") == \"1\") {\n       set_variable(\"defup\",\"0\")\n       display_notice(\"***DEFS UP***\",\"Yellow\")\n     } else if(pcrank == \"0\") {\n       set_variable(\"defup\",\"0\")\n       display_notice(\"***DEFS UP***\",\"Yellow\")\n     }\n}"}],"text":"beastdefup","matching":"exact","whole_words":true,"case_sensitive":true,"prefix_suffix":true},{"type":"trigger","name":"Need Wristblade","enabled":true,"actions":[{"type":"script","enabled":true,"script":"send_command(\"mwp mount wristblade\")"}],"text":"^You need to mount a wristblade to use the wristblade ability. Use MWP MOUNT WRISTBLADE.$","matching":"regexp","whole_words":true,"case_sensitive":true},{"type":"trigger","name":"No Wristblade","enabled":true,"actions":[{"type":"script","enabled":true,"script":"display_notice(\"Warning: No Wristblade detected in inventory, please buy one or ask your faction for help for one!\")"}],"text":"^You have nothing called 'wristblade' in your inventory.$","matching":"regexp","whole_words":true,"case_sensitive":true},{"type":"trigger","name":"Nozzle State Narrow","enabled":true,"actions":[{"type":"script","enabled":true,"script":"set_variable(\"nozzle_state\",\"narrow\")"}],"text":"^(Your plasmacaster nozzles are currently narrow.|The iris valves on your plasmacaster's jets contract.)$","matching":"regexp","whole_words":true,"case_sensitive":true},{"type":"trigger","name":"Nozzle State Wide Alr","enabled":true,"actions":[{"type":"script","enabled":true,"script":"set_variable(\"nozzle_state\",\"wide\")\nif(get_variable(\"defup\") == \"1\"){send_command(\"defup\")}"}],"text":"^Your plasmacaster nozzle aperture is already fully open.$","matching":"regexp","whole_words":true,"case_sensitive":true},{"type":"trigger","name":"Nozzle State Wide","enabled":true,"actions":[{"type":"script","enabled":true,"script":"set_variable(\"nozzle_state\",\"wide\")"}],"text":"^(Your plasmacaster nozzles are currently wide.|The iris valves on your plasmacaster's jets expand.)$","matching":"regexp","whole_words":true,"case_sensitive":true},{"type":"trigger","name":"Beast Resistance Got","enabled":true,"actions":[{"type":"script","enabled":true,"script":"set_variable(\"beast_resistance\",\"1\")"}],"text":"^You deploy extra heat sinks, protecting yourself from incoming thermal damage.$","matching":"regexp","whole_words":true,"case_sensitive":true},{"type":"trigger","name":"Beast Resistance Alr Got","enabled":true,"actions":[{"type":"script","enabled":true,"script":"set_variable(\"beast_resistance\",\"1\")\nif(get_variable(\"defup\") == \"1\") {send_command(\"defup\")}"}],"text":"^Your extra heat sinks are already deployed.$","matching":"regexp","whole_words":true,"case_sensitive":true},{"type":"trigger","name":"Beast Resistance Off","enabled":true,"actions":[{"type":"script","enabled":true,"script":"set_variable(\"beast_resistance\",\"0\")"}],"text":"^You withdraw the additional heat sinks into the suit's frame.$","matching":"regexp","whole_words":true,"case_sensitive":true},{"type":"trigger","name":"Not Enough Plasma - Auto Heatup","enabled":true,"actions":[{"type":"script","enabled":true,"script":"if(get_variable(\"plasma_heatup\") == \"0\") {send_command(\"plasma heatup\")}"}],"text":"^You lack the plasma to be able to do that.$","matching":"regexp","whole_words":true,"case_sensitive":true},{"type":"trigger","name":"Plasma Heat Up On","enabled":true,"actions":[{"type":"script","enabled":true,"script":"set_variable(\"plasma_heatup\",\"1\")"}],"text":"^A hissing noise signals that the conversion of overcharge into plasma has begun.$","matching":"regexp","whole_words":true,"case_sensitive":true},{"type":"trigger","name":"Plasma Heat Up Alr On","enabled":true,"actions":[{"type":"script","enabled":true,"script":"set_variable(\"plasma_heatup\",\"1\")\nif(get_variable(\"defup\") == \"1\"){send_command(\"defup\")}"}],"text":"^You're already generating plasma. PLASMA HEATUP OFF to disable.$","matching":"regexp","whole_words":true,"case_sensitive":true},{"type":"trigger","name":"Plasma Heat Up Alr Off","enabled":true,"actions":[{"type":"script","enabled":true,"script":"set_variable(\"plasma_heatup\",\"0\")"}],"text":"^You're not generating plasma.$","matching":"regexp","whole_words":true,"case_sensitive":true},{"type":"trigger","name":"Plasma Heat Up Off","enabled":true,"actions":[{"type":"script","enabled":true,"script":"set_variable(\"plasma_heatup\",\"0\")"}],"text":"^Your mindsim indicates that your plasma generation system is now offline.$","matchi